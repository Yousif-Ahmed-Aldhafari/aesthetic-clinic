  author             ClinicMembership   @relation("AssessmentAmendmentAuthor", fields: [clinicId, authorMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicId, id])
  @@index([clinicId, assessmentId, createdAt, id])
}

model TreatmentOutcome {
  id                     String                  @id @default(uuid()) @db.Uuid
  clinicId               String                  @db.Uuid
  patientId              String                  @db.Uuid
  followUpId             String?                 @db.Uuid
  procedureExecutionId   String?                 @db.Uuid
  treatmentPlanId        String?                 @db.Uuid
  photoComparisonGroupId String?                 @db.Uuid
  recordedByMembershipId String                  @db.Uuid
  measurementScale       OutcomeMeasurementScale
  clinicianScore         Decimal?                @db.Decimal(5, 2)
  clinicianNotes         String?                 @db.VarChar(2000)
  patientReportedScore   Decimal?                @db.Decimal(5, 2)
  patientReportedNotes   String?                 @db.VarChar(2000)
  recordedAt             DateTime                @db.Timestamptz(3)
  version                Int                     @default(1)
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)

  clinic                 Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patient                Patient                 @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  followUp               ClinicalFollowUp?       @relation(fields: [clinicId, followUpId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  procedureExecution     ProcedureExecution?     @relation(fields: [clinicId, procedureExecutionId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
