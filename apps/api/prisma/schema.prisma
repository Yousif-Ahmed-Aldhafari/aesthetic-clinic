// Phase 4 Step 4.1 — Inventory Foundation & Auditable Stock Movements

enum InventoryCategory {
  INJECTABLE
  SKINCARE
  CONSUMABLE
  RETAIL
  OTHER
}

enum InventoryUnit {
  PIECE
  VIAL
  BOX
  ML
  SYRINGE
}

enum InventoryLocationType {
  MAIN_STORE
  TREATMENT_ROOM
  RETAIL_AREA
  OTHER
}

enum InventoryMovementType {
  OPENING_BALANCE
  RECEIPT
  ISSUE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
}

enum InventoryReasonCode {
  INITIAL_COUNT
  PURCHASE_RECEIPT
  CLINICAL_USE
  EXPIRED
  DAMAGED
  DISCREPANCY_CORRECTION
  INTERNAL_TRANSFER
  RETURN
}

enum InventoryBatchStatus {
  AVAILABLE
  QUARANTINED
  RECALLED
  EXPIRED
  DEPLETED
}

enum ClinicalConsumptionStatus {
  RECORDED
  VOIDED
}

model InventoryProduct {
  id                    String                   @id @default(uuid()) @db.Uuid
  clinicId              String                   @db.Uuid
  sku                   String                   @db.VarChar(64)
  nameAr                String                   @db.VarChar(200)
  nameEn                String?                  @db.VarChar(200)
  category              InventoryCategory
  description           String?                  @db.VarChar(1000)
  unit                  InventoryUnit
  requiresBatchTracking Boolean                  @default(false)
  reorderThreshold      Decimal                  @default(0) @db.Decimal(12, 4)
  isActive              Boolean                  @default(true)
  version               Int                      @default(1)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)

  clinic                Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movements             InventoryStockMovement[]
  balances              InventoryBalance[]
  batches               InventoryBatch[]
  batchBalances         InventoryBatchBalance[]
  clinicalConsumptions  InventoryClinicalConsumption[]
  purchaseOrderLines    InventoryPurchaseOrderLine[]
  goodsReceiptLines     InventoryGoodsReceiptLine[]
  stockCountItems       InventoryStockCountItem[]
  interBranchTransfers  InterBranchTransfer[]
  costLayers            InventoryCostLayer[]

  @@unique([clinicId, id])
  @@unique([clinicId, sku])
  @@index([clinicId, category, isActive])
  @@index([clinicId, isActive])
}

model InventoryLocation {
  id              String                   @id @default(uuid()) @db.Uuid
  clinicId        String                   @db.Uuid
  branchId        String?                  @db.Uuid
  code            String                   @db.VarChar(32)
  nameAr          String                   @db.VarChar(150)
  nameEn          String?                  @db.VarChar(150)
  type            InventoryLocationType    @default(MAIN_STORE)
  description     String?                  @db.VarChar(500)
  isActive        Boolean                  @default(true)
  version         Int                      @default(1)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)

  clinic          Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch          ClinicBranch?            @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  movements       InventoryStockMovement[] @relation("LocationMovements")
  sourceMovements InventoryStockMovement[] @relation("SourceLocationMovements")
  balances        InventoryBalance[]
  batchBalances   InventoryBatchBalance[]
  clinicalConsumptions InventoryClinicalConsumption[]
  destinationPurchaseOrders InventoryPurchaseOrder[]
  destinationGoodsReceipts  InventoryGoodsReceipt[]
  goodsReceiptLines         InventoryGoodsReceiptLine[]
  stockCounts               InventoryStockCount[]
  sourceTransfers           InterBranchTransfer[] @relation("SourceLocationTransfers")
  destinationTransfers      InterBranchTransfer[] @relation("DestinationLocationTransfers")
  costLayers                InventoryCostLayer[]

  @@unique([clinicId, id])
  @@unique([clinicId, code])
  @@index([clinicId, branchId, type, isActive])
  @@index([clinicId, type, isActive])
}

model InventoryBatch {
  id               String                  @id @default(uuid()) @db.Uuid
  clinicId         String                  @db.Uuid
  productId        String                  @db.Uuid
  batchNumber      String                  @db.VarChar(100)
  expirationDate   DateTime                @db.Date
  status           InventoryBatchStatus    @default(AVAILABLE)
  initialQuantity  Decimal                 @db.Decimal(12, 4)
  manufacturerName String?                 @db.VarChar(200)
  supplierName     String?                 @db.VarChar(200)
  supplierId       String?                 @db.Uuid
  quarantinedAt    DateTime?               @db.Timestamptz(3)
  quarantineReason String?                 @db.VarChar(500)
  recalledAt       DateTime?               @db.Timestamptz(3)
  recallReason     String?                 @db.VarChar(500)
  version          Int                     @default(1)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)

  clinic           Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product          InventoryProduct        @relation(fields: [clinicId, productId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  supplier         InventorySupplier?      @relation(fields: [clinicId, supplierId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  batchBalances    InventoryBatchBalance[]
  movements        InventoryStockMovement[]
  consumptions     InventoryClinicalConsumption[]
  goodsReceiptLines InventoryGoodsReceiptLine[]
  stockCountItems  InventoryStockCountItem[]
  interBranchTransfers InterBranchTransfer[]
  costLayers       InventoryCostLayer[]

  @@unique([clinicId, id])
  @@unique([clinicId, productId, batchNumber])
  @@index([clinicId, status, expirationDate])
  @@index([clinicId, productId, status])
  @@index([clinicId, expirationDate])
}

model InventoryStockMovement {
  id                String                @id @default(uuid()) @db.Uuid
  clinicId          String                @db.Uuid
  productId         String                @db.Uuid
  locationId        String                @db.Uuid
  batchId           String?               @db.Uuid
  sourceLocationId  String?               @db.Uuid
  movementType      InventoryMovementType
  quantity          Decimal               @db.Decimal(12, 4)
  balanceAfter      Decimal               @db.Decimal(12, 4)
  reasonCode        InventoryReasonCode
  reasonExplanation String?               @db.VarChar(1000)
  actorMembershipId String                @db.Uuid
  idempotencyKey    String?               @db.VarChar(100)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)

  clinic            Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product           InventoryProduct      @relation(fields: [clinicId, productId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  location          InventoryLocation     @relation("LocationMovements", fields: [clinicId, locationId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceLocation    InventoryLocation?    @relation("SourceLocationMovements", fields: [clinicId, sourceLocationId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  batch             InventoryBatch?       @relation(fields: [clinicId, batchId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  actor             ClinicMembership      @relation("InventoryActor", fields: [clinicId, actorMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  balancesAsLast    InventoryBalance[]    @relation("LastMovement")
  consumptionsAsSource InventoryClinicalConsumption[] @relation("ConsumptionSourceMovement")
  consumptionsAsVoid   InventoryClinicalConsumption[] @relation("ConsumptionVoidMovement")
  goodsReceiptLines    InventoryGoodsReceiptLine[]
  stockCountItems      InventoryStockCountItem[]
  costMovements        InventoryCostMovement[]

  @@unique([clinicId, id])
  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, productId, locationId, createdAt])
  @@index([clinicId, batchId, createdAt])
  @@index([clinicId, movementType, createdAt])
  @@index([clinicId, actorMembershipId, createdAt])
}

model InterBranchTransfer {
  id                      String                    @id @default(uuid()) @db.Uuid
  clinicId                String                    @db.Uuid
  transferNumber          String                    @db.VarChar(50)
  sourceBranchId          String                    @db.Uuid
  destinationBranchId     String                    @db.Uuid
  sourceLocationId        String                    @db.Uuid
  destinationLocationId   String                    @db.Uuid
  productId               String                    @db.Uuid
  batchId                 String?                   @db.Uuid
  quantity                Decimal                   @db.Decimal(12, 4)
  status                  InterBranchTransferStatus @default(PENDING)
  dispatchedAt            DateTime?                 @db.Timestamptz(3)
  dispatchedByMembershipId String?                  @db.Uuid
  receivedAt              DateTime?                 @db.Timestamptz(3)
  receivedByMembershipId  String?                   @db.Uuid
  cancelledAt             DateTime?                 @db.Timestamptz(3)
  cancelledByMembershipId String?                   @db.Uuid
  notes                   String?                   @db.VarChar(1000)
  version                 Int                       @default(1)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(3)

  clinic                  Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceBranch            ClinicBranch              @relation("SourceBranchTransfers", fields: [clinicId, sourceBranchId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  destinationBranch       ClinicBranch              @relation("DestinationBranchTransfers", fields: [clinicId, destinationBranchId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceLocation          InventoryLocation         @relation("SourceLocationTransfers", fields: [clinicId, sourceLocationId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  destinationLocation     InventoryLocation         @relation("DestinationLocationTransfers", fields: [clinicId, destinationLocationId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  product                 InventoryProduct          @relation(fields: [clinicId, productId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  batch                   InventoryBatch?           @relation(fields: [clinicId, batchId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  dispatchedBy            ClinicMembership?         @relation("TransferDispatcher", fields: [clinicId, dispatchedByMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
