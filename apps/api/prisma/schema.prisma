  clinicId               String              @db.Uuid
  patientId              String              @db.Uuid
  followUpId             String?             @db.Uuid
  procedureExecutionId   String?             @db.Uuid
  reportedByMembershipId String              @db.Uuid
  eventType              String              @db.VarChar(100)
