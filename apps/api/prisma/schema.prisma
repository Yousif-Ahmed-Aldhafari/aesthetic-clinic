}

enum LandedCostAllocationMethod {
  BY_QUANTITY
  BY_VALUE
}

enum LandedCostStatus {
  DRAFT
  APPROVED
  ADJUSTED
}

enum CostMovementType {
  RECEIPT
  ISSUE
  CONSUMPTION
  WASTE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT
}

enum ValuationSnapshotStatus {
  PROVISIONAL
  APPROVED
  SUPERSEDED
