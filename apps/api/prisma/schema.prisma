model InventoryCostLayer {
  id                      String                    @id @default(uuid()) @db.Uuid
  clinicId                String                    @db.Uuid
  productId               String                    @db.Uuid
  branchId                String?                   @db.Uuid
  locationId              String?                   @db.Uuid
  batchId                 String?                   @db.Uuid
  goodsReceiptLineId      String?                   @db.Uuid
  layerDate               DateTime                  @default(now()) @db.Timestamptz(3)
  initialQuantity         Decimal                   @db.Decimal(12, 4)
  remainingQuantity       Decimal                   @db.Decimal(12, 4)
  unitAcquisitionCostMinor BigInt                   @default(0)
  unitLandedCostMinor     BigInt                    @default(0)
  totalRemainingCostMinor BigInt                    @default(0)
  costStatus              InventoryCostStatus       @default(VERIFIED)
  sourceProvenance        InventoryCostProvenance   @default(GOODS_RECEIPT)
  currency                String                    @default("SAR") @db.VarChar(3)
  version                 Int                       @default(1)
  createdAt               DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                  @updatedAt @db.Timestamptz(3)

  clinic                  Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product                 InventoryProduct          @relation(fields: [clinicId, productId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  branch                  ClinicBranch?             @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  location                InventoryLocation?        @relation(fields: [clinicId, locationId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  batch                   InventoryBatch?           @relation(fields: [clinicId, batchId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  goodsReceiptLine        InventoryGoodsReceiptLine? @relation(fields: [clinicId, goodsReceiptLineId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  movements               InventoryCostMovement[]
  allocationLines         InventoryLandedCostAllocationLine[]
  adjustments             InventoryCostAdjustment[]

  @@unique([clinicId, id])
  @@index([clinicId, productId, costStatus, layerDate])
  @@index([clinicId, branchId, costStatus])
  @@index([clinicId, batchId])
}

model InventoryLandedCost {
