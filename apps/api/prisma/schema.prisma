generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

// Platform authority is global and never confers clinic membership access.
enum PlatformRole {
  PLATFORM_ADMIN
}

enum ClinicRole {
  CLINIC_OWNER
  CLINIC_ADMIN
  DOCTOR
  RECEPTIONIST
  ACCOUNTANT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

// Tenant root: scoped private SELECT; fixed public/identity bootstrap functions.
model Clinic {
  id             String             @id @default(uuid()) @db.Uuid
  legalName      String             @db.VarChar(200)
  displayName    String             @db.VarChar(150)
  englishName    String?            @db.VarChar(150)
  contactPhone   String?            @db.VarChar(16)
  contactEmail   String?            @db.VarChar(254)
  address        String?            @db.VarChar(250)
  latitude       Decimal?           @db.Decimal(9, 6)
  longitude      Decimal?           @db.Decimal(9, 6)
  version        Int                @default(1)
  slug           String             @unique @db.VarChar(63)
  status         ClinicStatus       @default(ACTIVE)
  timezone       String             @default("UTC") @db.VarChar(100)
  currency       String             @db.Char(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  branding       ClinicBranding?
  domains        ClinicDomain[]
  memberships    ClinicMembership[]
  sessions       Session[]
  patients       Patient[]
  patientCounter PatientCounter?
  services ClinicService[]
  resources BookableResource[]
  appointments Appointment[]
  availability ResourceAvailability[]
  timeOff ResourceTimeOff[]
  schedulingState SchedulingState?
  visits Visit[]
  queueTickets QueueTicket[]
  queueCounters QueueCounter[]
  queueConfiguration QueueConfiguration?
  queueCommands QueueCommand[]
  invoices Invoice[]
  invoiceLines InvoiceLine[]
  payments Payment[]
  paymentReversals PaymentReversal[]
  financialAuditEvents FinancialAuditEvent[]
  invoiceCounter ClinicInvoiceCounter?
  billingProfile ClinicBillingProfile?
  assets ClinicAsset[]
  identityState ClinicIdentityState?
  identityAuditEvents ClinicIdentityAuditEvent[]
  slugReservations ClinicSlugReservation[]
  auditEvents AuditEvent[]

  @@index([status, createdAt])
}

// Tenant resource: FORCE RLS and immutable clinicId.
model ClinicBranding {
  clinicId       String   @id @db.Uuid
  logoUrl        String?  @db.VarChar(2048)
  primaryColor   String   @default("#7854D9") @db.VarChar(7)
  secondaryColor String   @default("#F6F8FC") @db.VarChar(7)
  accentColor    String?  @db.VarChar(7)
  faviconUrl     String?  @db.VarChar(2048)
  typography     String   @default("TAJAWAL") @db.VarChar(20)
  logoAssetId    String?  @db.Uuid
  faviconAssetId String?  @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  logoAsset ClinicAsset? @relation("ClinicLogo", fields: [clinicId, logoAssetId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  faviconAsset ClinicAsset? @relation("ClinicFavicon", fields: [clinicId, faviconAssetId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
}

// Tenant resource: FORCE RLS and immutable clinicId.
model ClinicDomain {
  id                 String                   @id @default(uuid()) @db.Uuid
  clinicId           String                   @db.Uuid
  hostname           String                   @unique @db.VarChar(253)
  verificationStatus DomainVerificationStatus @default(PENDING)
  isPrimary          Boolean                  @default(false)
  challengeHash      String?                  @db.Char(64)
  challengeExpiresAt DateTime?                @db.Timestamptz(3)
  verifiedAt         DateTime?                @db.Timestamptz(3)
  lastCheckedAt      DateTime?                @db.Timestamptz(3)
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)
  clinic             Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicId, id])
  @@index([clinicId, verificationStatus])
}

// Immutable encoded derivatives only; originals are never stored or published.
model ClinicAsset {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  purpose String @db.VarChar(10)
  storageKey String @unique @db.VarChar(100)
  mimeType String @db.VarChar(20)
  byteSize Int
  width Int
  height Int
  sha256 String @db.Char(64)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  logoFor ClinicBranding[] @relation("ClinicLogo")
  faviconFor ClinicBranding[] @relation("ClinicFavicon")
  @@unique([clinicId,id])
  @@index([clinicId,publishedAt,createdAt])
}

// Retain former platform names to prevent another clinic claiming old links.
// Only explicit owner maintenance can remove a clinic; no runtime delete path.
model ClinicSlugReservation {
  slug String @id @db.VarChar(63)
  clinicId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Cascade,onUpdate:Restrict)
  @@index([clinicId,createdAt])
}

// Trigger-owned serialization/hash-chain head; runtime cannot mutate it directly.
model ClinicIdentityState {
  clinicId String @id @db.Uuid
  lastSequence Int @default(0)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
}

model ClinicIdentityAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  sequence Int
  actorUserId String @db.Uuid
  actorMembershipId String @db.Uuid
  action String @db.VarChar(60)
  targetId String @db.Uuid
  payload String @db.Text
  previousHash String @db.Char(64)
  eventHash String @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([clinicId,sequence])
  @@index([clinicId,createdAt,id])
}

// Global identity: auth-only read path; runtime cannot write users.
model User {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @db.VarChar(150)
  email        String             @unique @db.VarChar(254)
  passwordHash String?            @db.VarChar(255)
  status       UserStatus         @default(INVITED)
  platformRole PlatformRole?
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  memberships  ClinicMembership[]
  authVersion  Int                @default(0)
  sessions     Session[]
}

// Tenant resource and identity bridge: scoped SELECT, maintenance-only writes.
model ClinicMembership {
  id        String           @id @default(uuid()) @db.Uuid
  clinicId  String           @db.Uuid
  userId    String           @db.Uuid
  role      ClinicRole
  status    MembershipStatus @default(INVITED)
  version   Int              @default(1)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  clinic    Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  bookableResource BookableResource?
  financialAuditEvents FinancialAuditEvent[]

  // One current role per user/clinic; the same user can join many clinics.
  @@unique([clinicId, userId])
  @@unique([clinicId, id])
  @@index([userId, status])
  @@index([clinicId, status, role])
}

// Global identity infrastructure, never an authorization grant for a clinic.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique @db.Char(64)
  csrfHash          String    @db.Char(64)
  authorizationHash String    @db.Char(64)
  selectedClinicId  String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  selectedClinic    Clinic?   @relation(fields: [selectedClinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// Global security infrastructure; no tenant access grant.
model LoginBucket {
  key       String   @id @db.Char(64)
  attempts  Int      @default(1)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

// Optional, self-reported administrative gender, never inferred or clinical sex.
enum PatientGender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

// Administrative identity/contact only. No clinical/free-text notes or media.
model Patient {
  id            String         @id @default(uuid()) @db.Uuid
  clinicId      String         @db.Uuid
  patientNumber String         @db.VarChar(20)
  fullName      String         @db.VarChar(150)
  searchName    String         @db.VarChar(150)
  phone         String?        @db.VarChar(16)
  email         String?        @db.VarChar(254)
  dateOfBirth   DateTime?      @db.Date
  gender        PatientGender?
  status        PatientStatus  @default(ACTIVE)
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicId, id])
  appointments Appointment[]
  visits Visit[]
  invoices Invoice[]

  @@unique([clinicId, patientNumber])
  @@index([clinicId, createdAt, id])
  @@index([clinicId, status, createdAt, id])
  @@index([clinicId, searchName])
  @@index([clinicId, phone])
}

// Row-locked transactional allocator; runtime cannot delete or decrement it.
model PatientCounter {
  clinicId   String @id @db.Uuid
  lastNumber Int
  clinic     Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}


enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ResourceKind {
  DOCTOR
  ROOM
}

enum CancellationReason {
  PATIENT_REQUEST
  SCHEDULE_CHANGE
  OTHER
}

model ClinicService {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  name String @db.VarChar(100)
  durationMinutes Int
  requiresRoom Boolean @default(false)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  appointments Appointment[]
  @@unique([clinicId,id])
  @@index([clinicId,active,id])
}

model BookableResource {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  kind ResourceKind
  label String @db.VarChar(100)
  doctorMembershipId String? @db.Uuid
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  doctorMembership ClinicMembership? @relation(fields:[clinicId,doctorMembershipId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  doctorAppointments Appointment[] @relation("AppointmentDoctor")
  roomAppointments Appointment[] @relation("AppointmentRoom")
  doctorTickets QueueTicket[] @relation("QueueDoctor")
  roomTickets QueueTicket[] @relation("QueueRoom")
  availability ResourceAvailability[]
  timeOff ResourceTimeOff[]
  @@unique([clinicId,id])
  @@unique([clinicId,id,kind])
  @@unique([clinicId,doctorMembershipId])
  @@index([clinicId,kind,active,id])
}

model ResourceAvailability {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  resourceId String @db.Uuid
  weekday Int
  startMinute Int
  endMinute Int
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  resource BookableResource @relation(fields:[clinicId,resourceId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  @@index([clinicId,resourceId,weekday])
}

model ResourceTimeOff {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  resourceId String @db.Uuid
  startAt DateTime @db.Timestamptz(3)
  endAt DateTime @db.Timestamptz(3)
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  resource BookableResource @relation(fields:[clinicId,resourceId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  @@index([clinicId,resourceId,active,startAt])
}

// Small, tenant-local writer mutex: schedule changes and reservations share it.
model SchedulingState {
  clinicId String @id @db.Uuid
  revision BigInt @default(1)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
}

model Appointment {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  patientId String @db.Uuid
  serviceId String @db.Uuid
  doctorResourceId String @db.Uuid
  doctorKind ResourceKind @default(DOCTOR)
  roomResourceId String? @db.Uuid
  roomKind ResourceKind @default(ROOM)
  startAt DateTime @db.Timestamptz(3)
  endAt DateTime @db.Timestamptz(3)
  status AppointmentStatus @default(SCHEDULED)
  cancellationReason CancellationReason?
  version Int @default(1)
  bookingKey String @db.Uuid
  requestHash String @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  patient Patient @relation(fields:[clinicId,patientId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  service ClinicService @relation(fields:[clinicId,serviceId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  doctor BookableResource @relation("AppointmentDoctor",fields:[clinicId,doctorResourceId,doctorKind],references:[clinicId,id,kind],onDelete:Restrict,onUpdate:Restrict)
  room BookableResource? @relation("AppointmentRoom",fields:[clinicId,roomResourceId,roomKind],references:[clinicId,id,kind],onDelete:Restrict,onUpdate:Restrict)
  visit Visit?
  @@unique([clinicId,id])
  @@unique([clinicId,bookingKey])
  @@index([clinicId,startAt,id])
  @@index([clinicId,patientId,startAt,id])
  @@index([clinicId,doctorResourceId,startAt,id])
}

enum VisitSource {
  APPOINTMENT
  WALK_IN
}

enum VisitStatus {
  WAITING
  IN_SERVICE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueStatus {
  WAITING
  CALLED
  IN_SERVICE
  COMPLETED
  CANCELLED
  ABSENT
}

// Administrative attendance only; never clinical consultation records.
model Visit {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  patientId String @db.Uuid
  appointmentId String? @db.Uuid
  source VisitSource
  status VisitStatus @default(WAITING)
  checkInKey String @db.Uuid
  requestHash String @db.Char(64)
  checkedInAt DateTime @default(now()) @db.Timestamptz(3)
  startedAt DateTime? @db.Timestamptz(3)
  endedAt DateTime? @db.Timestamptz(3)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  patient Patient @relation(fields:[clinicId,patientId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  appointment Appointment? @relation(fields:[clinicId,appointmentId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  ticket QueueTicket?
  invoices Invoice[]
  @@unique([clinicId,id,patientId])
  @@unique([clinicId,id])
  @@unique([clinicId,appointmentId])
  @@unique([clinicId,checkInKey])
  @@index([clinicId,checkedInAt,id])
  @@index([clinicId,patientId,checkedInAt])
}

model QueueTicket {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  visitId String @db.Uuid
  businessDate DateTime @db.Date
  number Int
  doctorResourceId String @db.Uuid
  doctorKind ResourceKind @default(DOCTOR)
  roomResourceId String? @db.Uuid
  roomKind ResourceKind @default(ROOM)
  status QueueStatus @default(WAITING)
  queuedAt DateTime @default(now()) @db.Timestamptz(3)
  calledAt DateTime? @db.Timestamptz(3)
  recallCount Int @default(0)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  visit Visit @relation(fields:[clinicId,visitId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  doctor BookableResource @relation("QueueDoctor",fields:[clinicId,doctorResourceId,doctorKind],references:[clinicId,id,kind],onDelete:Restrict,onUpdate:Restrict)
  room BookableResource? @relation("QueueRoom",fields:[clinicId,roomResourceId,roomKind],references:[clinicId,id,kind],onDelete:Restrict,onUpdate:Restrict)
  commands QueueCommand[]
  @@unique([clinicId,id])
  @@unique([clinicId,visitId])
  @@unique([clinicId,businessDate,number])
  @@index([clinicId,status,queuedAt,id])
  @@index([clinicId,doctorResourceId,status,queuedAt,id])
  @@index([clinicId,businessDate,number])
}

// Clinic-wide daily numbering, independent of doctor/room assignment.
model QueueCounter {
  clinicId String @db.Uuid
  businessDate DateTime @db.Date
  lastNumber Int
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@id([clinicId,businessDate])
}

model QueueConfiguration {
  clinicId String @id @db.Uuid
  publicDisplayEnabled Boolean @default(false)
  version Int @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
}

// Durable call-next replay ledger: a retried request never claims a second ticket.
model QueueCommand {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  requestKey String @db.Uuid
  requestHash String @db.Char(64)
  ticketId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  ticket QueueTicket? @relation(fields:[clinicId,ticketId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([clinicId,requestKey])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD_MANUAL
}

enum ReversalKind {
  REFUND
  REVERSAL
}

enum FinancialReason {
  ADMIN_ERROR
  DUPLICATE
  PATIENT_REFUND
  OTHER
}

// Exact minor units. No floating point amounts, inferred currency or conversion.
model Invoice {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  patientId String @db.Uuid
  visitId String? @db.Uuid
  number String? @db.VarChar(24)
  currency String @db.Char(3)
  currencyScale Int
  status InvoiceStatus @default(DRAFT)
  subtotalMinor BigInt
  discountMinor BigInt
  taxMinor BigInt
  totalMinor BigInt
  netPaidMinor BigInt @default(0)
  patientName String @db.VarChar(150)
  patientNumber String @db.VarChar(20)
  issuerSnapshot Json?
  issuedAt DateTime? @db.Timestamptz(3)
  voidedAt DateTime? @db.Timestamptz(3)
  voidReason FinancialReason?
  version Int @default(1)
  requestKey String @db.Uuid
  requestHash String @db.Char(64)
  issueKey String? @db.Uuid
  issueHash String? @db.Char(64)
  voidKey String? @db.Uuid
  voidHash String? @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  patient Patient @relation(fields:[clinicId,patientId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  visit Visit? @relation(fields:[clinicId,visitId,patientId],references:[clinicId,id,patientId],onDelete:Restrict,onUpdate:Restrict)
  lines InvoiceLine[]
  payments Payment[]
  reversals PaymentReversal[]
  auditEvents FinancialAuditEvent[]
  @@unique([clinicId,id])
  @@unique([clinicId,number])
  @@unique([clinicId,requestKey])
  @@index([clinicId,status,createdAt,id])
  @@index([clinicId,patientId,createdAt,id])
}

model InvoiceLine {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  invoiceId String @db.Uuid
  position Int
  serviceName String @db.VarChar(120)
  description String? @db.VarChar(240)
  quantityMilli Int
  unitPriceMinor BigInt
  grossMinor BigInt
  discountMinor BigInt
  taxBasisPoints Int
  taxMinor BigInt
  totalMinor BigInt
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  invoice Invoice @relation(fields:[clinicId,invoiceId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([clinicId,invoiceId,position])
}

// A recorded payment applies to exactly one invoice; allocations are unnecessary.
model Payment {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  invoiceId String @db.Uuid
  amountMinor BigInt
  currency String @db.Char(3)
  currencyScale Int
  method PaymentMethod
  requestKey String @db.Uuid
  requestHash String @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  invoice Invoice @relation(fields:[clinicId,invoiceId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  reversals PaymentReversal[]
  @@unique([clinicId,id])
  @@unique([clinicId,id,invoiceId])
  @@unique([clinicId,requestKey])
  @@index([clinicId,invoiceId,createdAt,id])
}

model PaymentReversal {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  invoiceId String @db.Uuid
  paymentId String @db.Uuid
  kind ReversalKind
  reason FinancialReason
  amountMinor BigInt
  currency String @db.Char(3)
  currencyScale Int
  requestKey String @db.Uuid
  requestHash String @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  invoice Invoice @relation(fields:[clinicId,invoiceId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  payment Payment @relation(fields:[clinicId,paymentId,invoiceId],references:[clinicId,id,invoiceId],onDelete:Restrict,onUpdate:Restrict)
  @@unique([clinicId,requestKey])
  @@index([clinicId,paymentId,createdAt,id])
}

model FinancialAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  invoiceId String? @db.Uuid
  actorMembershipId String @db.Uuid
  sequence Int
  action String @db.VarChar(32)
  payload String @db.Text
  previousHash String @db.Char(64)
  eventHash String @db.Char(64)
  createdAt DateTime @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  invoice Invoice? @relation(fields:[clinicId,invoiceId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  actor ClinicMembership @relation(fields:[clinicId,actorMembershipId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([clinicId,sequence])
  @@index([clinicId,invoiceId,sequence])
}

// Also serializes financial writes and audit append order inside one clinic.
model ClinicInvoiceCounter {
  clinicId String @id @db.Uuid
  lastNumber Int @default(0)
  revision BigInt @default(1)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
}

model ClinicBillingProfile {
  clinicId String @id @db.Uuid
  address String? @db.VarChar(250)
  registrationNumber String? @db.VarChar(50)
  taxIdentifier String? @db.VarChar(50)
  version Int @default(1)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
}

enum AuditCategory {
  AUTH
  IDENTITY
  STAFF
  PATIENTS
  SCHEDULING
  QUEUE
  FINANCE
  SECURITY
  PLATFORM
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

// Centralized operational audit trail; append-only, tenant-scoped, and immutable.
model AuditEvent {
  id            String        @id @default(uuid()) @db.Uuid
  clinicId      String?       @db.Uuid
  actorId       String?       @db.Uuid
  actorEmail    String?       @db.VarChar(254)
  action        String        @db.VarChar(64)
  category      AuditCategory
  targetType    String?       @db.VarChar(64)
  targetId      String?       @db.VarChar(64)
  outcome       AuditOutcome  @default(SUCCESS)
  correlationId String?       @db.VarChar(64)
  ipAddress     String?       @db.VarChar(64)
  userAgent     String?       @db.VarChar(256)
  metadata      Json?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  clinic        Clinic?       @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([clinicId, createdAt, id])
  @@index([clinicId, category, createdAt])
  @@index([clinicId, action, createdAt])
  @@index([clinicId, actorId, createdAt])
  @@index([correlationId])
}

