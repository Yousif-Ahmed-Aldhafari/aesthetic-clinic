  providerCode           PaymentProviderCode
  mode                   IntegrationMode      @default(SANDBOX)
  isEnabled              Boolean              @default(false)
  supportedCurrencies    String[]
  jurisdiction           String               @default("SA") @db.VarChar(16)
  capabilities           Json
  encryptedApiKey        String?              @db.Text
  encryptedWebhookSecret String?              @db.Text
  keyVersion             Int                  @default(1)
  secretFingerprint      String?              @db.Char(16)
