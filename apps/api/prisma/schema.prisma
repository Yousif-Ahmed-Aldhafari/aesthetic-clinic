  payments Payment[]
  reversals PaymentReversal[]
  auditEvents FinancialAuditEvent[]
  patientPackages PatientPackage[]
  installmentPlans InstallmentPlan[]
  refundRequests RefundRequest[]
  commissionAccruals PractitionerCommissionAccrual[]
  paymentIntents PaymentIntent[]
  regulatoryDocuments RegulatoryDocument[]
  @@unique([clinicId,id])
  @@unique([clinicId,number])
  @@unique([clinicId,requestKey])
  @@index([clinicId,branchId,status,createdAt,id])
  @@index([clinicId,status,createdAt,id])
