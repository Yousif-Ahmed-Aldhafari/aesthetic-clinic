enum FollowUpStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  MISSED
}

enum FollowUpSeverity {
  MILD
  MODERATE
  SEVERE
}

enum AdverseEventStatus {
  REPORTED
  UNDER_EVALUATION
  RESOLVED
  ESCALATED
}

enum OutcomeMeasurementScale {
  CLINICAL_GLOBAL_IMPRESSION
  PATIENT_SATISFACTION_5_POINT
  VISUAL_ANALOG_SCALE_10
  STRUCTURED_OBSERVATION
}

model ClinicalFollowUp {
  id                         String              @id @default(uuid()) @db.Uuid
  clinicId                   String              @db.Uuid
  patientId                  String              @db.Uuid
  treatingDoctorMembershipId String              @db.Uuid
  encounterId                String?             @db.Uuid
  treatmentPlanId            String?             @db.Uuid
  procedureExecutionId       String?             @db.Uuid
  appointmentId              String?             @db.Uuid
  status                     FollowUpStatus      @default(SCHEDULED)
  reason                     String              @db.VarChar(500)
  scheduledDate              DateTime            @db.Timestamptz(3)
  completedAt                DateTime?           @db.Timestamptz(3)
  cancelledAt                DateTime?           @db.Timestamptz(3)
  cancelReason               String?             @db.VarChar(500)
  recoveryInstructions       String?             @db.VarChar(2000)
  version                    Int                 @default(1)
  createdAt                  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime            @updatedAt @db.Timestamptz(3)

  clinic                     Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patient                    Patient             @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  treatingDoctor             ClinicMembership    @relation("FollowUpTreatingDoctor", fields: [clinicId, treatingDoctorMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  encounter                  ClinicalEncounter?  @relation(fields: [clinicId, encounterId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  treatmentPlan              TreatmentPlan?      @relation(fields: [clinicId, treatmentPlanId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  procedureExecution         ProcedureExecution? @relation(fields: [clinicId, procedureExecutionId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  appointment                Appointment?        @relation(fields: [clinicId, appointmentId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)

  assessment                 FollowUpAssessment?
  outcomes                   TreatmentOutcome[]
  adverseEvents              AdverseEvent[]

  @@unique([clinicId, id])
  @@index([clinicId, patientId, scheduledDate, id])
  @@index([clinicId, status, scheduledDate])
  @@index([clinicId, treatingDoctorMembershipId, scheduledDate])
}

model FollowUpAssessment {
  id                   String                       @id @default(uuid()) @db.Uuid
  clinicId             String                       @db.Uuid
  followUpId           String                       @unique @db.Uuid
  doctorMembershipId   String                       @db.Uuid
  symptomsObserved     String                       @db.VarChar(2000)
  healingProgress      String                       @db.VarChar(1000)
  clinicalNotes        String                       @db.VarChar(4000)
  signedAt             DateTime?                    @db.Timestamptz(3)
  signatureSha256      String?                      @db.VarChar(64)
  version              Int                          @default(1)
  createdAt            DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @db.Timestamptz(3)

  clinic               Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  followUp             ClinicalFollowUp             @relation(fields: [clinicId, followUpId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  doctor               ClinicMembership             @relation("FollowUpAssessmentDoctor", fields: [clinicId, doctorMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  amendments           FollowUpAssessmentAmendment[]

  @@unique([clinicId, id])
  @@unique([clinicId, followUpId])
  @@index([clinicId, doctorMembershipId, createdAt])
}

model FollowUpAssessmentAmendment {
  id                 String             @id @default(uuid()) @db.Uuid
  clinicId           String             @db.Uuid
  assessmentId       String             @db.Uuid
  authorMembershipId String             @db.Uuid
  amendmentReason    String             @db.VarChar(1000)
  amendedContent     String             @db.VarChar(4000)
  signedAt           DateTime           @db.Timestamptz(3)
  signatureSha256    String             @db.VarChar(64)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)

  clinic             Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
