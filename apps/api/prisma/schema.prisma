// Controlled, versioned clinical safety policies and clinical protocol registry
model ClinicalSafetyPolicy {
  id              String                 @id @default(uuid()) @db.Uuid
  clinicId        String                 @db.Uuid
  code            String                 @db.VarChar(64)
  titleAr         String                 @db.VarChar(200)
  titleEn         String?                @db.VarChar(200)
  description     String?                @db.Text
  category        ClinicalPolicyCategory @default(GENERAL_SAFETY)
  specialtyId     String?                @db.Uuid
  jurisdiction    String                 @default("GLOBAL") @db.VarChar(32)
  status          ClinicalPolicyStatus   @default(DRAFT)
  activeVersionId String?                @db.Uuid
  version         Int                    @default(1)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)

  clinic          Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  specialty       MedicalSpecialty?      @relation(fields: [specialtyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions        ClinicalSafetyPolicyVersion[]
  activeVersion   ClinicalSafetyPolicyVersion? @relation("ActivePolicyVersion", fields: [clinicId, activeVersionId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicId, id])
  @@unique([clinicId, code])
  @@index([clinicId, category, status])
  @@index([clinicId, jurisdiction])
}

model ClinicalSafetyPolicyVersion {
  id                     String               @id @default(uuid()) @db.Uuid
  clinicId               String               @db.Uuid
  policyId               String               @db.Uuid
  versionNumber          Int
  rulesJson              Json                 @db.JsonB
  changeSummary          String?              @db.VarChar(500)
  status                 ClinicalPolicyStatus @default(DRAFT)
  sha256Digest           String               @db.Char(64)
  authorMembershipId     String               @db.Uuid
  approvedByMembershipId String?              @db.Uuid
  approvedAt             DateTime?            @db.Timestamptz(3)
  effectiveFrom          DateTime?            @db.Timestamptz(3)
  effectiveTo            DateTime?            @db.Timestamptz(3)
  evidenceReference      String?              @db.VarChar(255)
  version                Int                  @default(1)
  createdAt              DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime             @updatedAt @db.Timestamptz(3)

  clinic                 Clinic               @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  policy                 ClinicalSafetyPolicy @relation(fields: [clinicId, policyId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  author                 ClinicMembership     @relation("SafetyPolicyAuthor", fields: [clinicId, authorMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
