  @@index([clinicId, patientId, createdAt, id])
}

model PhotoAnnotation {
  id                    String            @id @default(uuid()) @db.Uuid
  clinicId              String            @db.Uuid
  photoId               String            @db.Uuid
  authorMembershipId    String            @db.Uuid
  annotationType        String            @db.VarChar(50)
  geometryJson          String?           @db.VarChar(2000)
  comment               String            @db.VarChar(1000)
  version               Int               @default(1)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  clinic                Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  photo                 ClinicalPhoto     @relation(fields: [clinicId, photoId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  author                ClinicMembership  @relation("PhotoAnnotationAuthor", fields: [clinicId, authorMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)

