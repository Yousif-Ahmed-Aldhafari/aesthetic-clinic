  patientId                  String?                  @db.Uuid
  encounterId                String?                  @db.Uuid
  reportedByMembershipId     String                   @db.Uuid
  occurredAt                 DateTime                 @db.Timestamptz(3)
  reportedAt                 DateTime                 @default(now()) @db.Timestamptz(3)
  description                String                   @db.Text
  immediateActionTaken       String?                  @db.Text
  investigationFindings      String?                  @db.Text
  rootCauseAnalysis          String?                  @db.Text
  correctiveActions          String?                  @db.Text
  investigatedByMembershipId String?                  @db.Uuid
  resolvedAt                 DateTime?                @db.Timestamptz(3)
  closedAt                   DateTime?                @db.Timestamptz(3)
  version                    Int                      @default(1)
  createdAt                  DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime                 @updatedAt @db.Timestamptz(3)

  clinic                     Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patient                    Patient?                 @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  encounter                  ClinicalEncounter?       @relation(fields: [clinicId, encounterId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  reportedBy                 ClinicMembership         @relation("IncidentReporter", fields: [clinicId, reportedByMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  investigatedBy             ClinicMembership?        @relation("IncidentInvestigator", fields: [clinicId, investigatedByMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicId, id])
  @@unique([clinicId, incidentNumber])
  @@index([clinicId, severity, status])
  @@index([clinicId, category])
  @@index([clinicId, patientId])
}

// Row-locked atomic sequence allocator for clinical incidents
model ClinicalIncidentCounter {
