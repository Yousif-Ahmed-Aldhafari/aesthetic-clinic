  @@index([clinicId, photoSessionId, id])
}

model PhotoComparisonGroup {
  id                    String            @id @default(uuid()) @db.Uuid
  clinicId              String            @db.Uuid
  patientId             String            @db.Uuid
  clinicianMembershipId String            @db.Uuid
  title                 String            @db.VarChar(200)
  notes                 String?           @db.VarChar(1000)
  beforePhotoId         String            @db.Uuid
  afterPhotoId          String            @db.Uuid
  version               Int               @default(1)
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  clinic                Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patient               Patient           @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  clinician             ClinicMembership  @relation("PhotoComparisonClinician", fields: [clinicId, clinicianMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
