// Step 4.4: Treatment Packages, Prepaid Sessions, Installments & Refunds
// =============================================================================

enum PackageStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum PatientPackageStatus {
  PENDING_PAYMENT
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
}

enum PackageActivationPolicy {
  UPON_INVOICE_ISSUANCE
  UPON_FULL_PAYMENT
  MANUAL_OVERRIDE
}

enum PackageRedemptionStatus {
  RECORDED
  REVERSED
}

enum InstallmentPlanStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  OVERDUE
}

enum InstallmentScheduleStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum RefundRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  SETTLED
  CANCELLED
}

model TreatmentPackage {
  id               String                    @id @default(uuid()) @db.Uuid
  clinicId         String                    @db.Uuid
  code             String                    @db.VarChar(50)
  nameAr           String                    @db.VarChar(150)
  nameEn           String?                   @db.VarChar(150)
  description      String?                   @db.Text
  status           PackageStatus             @default(DRAFT)
  currentVersionId String?                   @db.Uuid
  version          Int                       @default(1)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(3)

  clinic           Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions         TreatmentPackageVersion[]
  patientPackages  PatientPackage[]

  @@unique([clinicId, id])
  @@unique([clinicId, code])
  @@index([clinicId, status, createdAt])
}

model TreatmentPackageVersion {
  id                      String                 @id @default(uuid()) @db.Uuid
  clinicId                String                 @db.Uuid
  packageId               String                 @db.Uuid
  versionNumber           Int
  nameAr                  String                 @db.VarChar(150)
  nameEn                  String?                @db.VarChar(150)
  description             String?                @db.Text
  terms                   String?                @db.Text
  priceMinor              BigInt
  currency                String                 @db.Char(3)
  currencyScale           Int
  validityDays            Int                    @default(365)
  isPublished             Boolean                @default(false)
  publishedAt             DateTime?              @db.Timestamptz(3)
  publishedByMembershipId String?                @db.Uuid
  notes                   String?                @db.Text
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime               @updatedAt @db.Timestamptz(3)

  clinic                  Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  package                 TreatmentPackage       @relation(fields: [clinicId, packageId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  publishedBy             ClinicMembership?      @relation("PackageVersionPublisher", fields: [clinicId, publishedByMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  items                   TreatmentPackageItem[]
  patientPackages         PatientPackage[]

  @@unique([clinicId, id])
  @@unique([clinicId, packageId, versionNumber])
  @@index([clinicId, isPublished])
}

model TreatmentPackageItem {
  id               String                    @id @default(uuid()) @db.Uuid
  clinicId         String                    @db.Uuid
  packageVersionId String                    @db.Uuid
  procedureId      String?                   @db.Uuid
  serviceName      String                    @db.VarChar(120)
  sessionQuantity  Int
  notes            String?                   @db.Text

  clinic           Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  packageVersion   TreatmentPackageVersion   @relation(fields: [clinicId, packageVersionId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  procedure        AestheticProcedureCatalog? @relation(fields: [clinicId, procedureId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicId, id])
  @@index([clinicId, packageVersionId])
}

model PatientPackage {
  id                 String                      @id @default(uuid()) @db.Uuid
  clinicId           String                      @db.Uuid
  patientId          String                      @db.Uuid
  packageId          String                      @db.Uuid
  packageVersionId   String                      @db.Uuid
  invoiceId          String?                     @db.Uuid
  status             PatientPackageStatus        @default(PENDING_PAYMENT)
  activationPolicy   PackageActivationPolicy     @default(UPON_FULL_PAYMENT)
  purchasedAt        DateTime                    @default(now()) @db.Timestamptz(3)
  activatedAt        DateTime?                   @db.Timestamptz(3)
  expiresAt          DateTime?                   @db.Timestamptz(3)
  totalSessions      Int
  redeemedSessions   Int                         @default(0)
  remainingSessions  Int
  version            Int                         @default(1)
  requestKey         String                      @db.Uuid
  requestHash        String                      @db.Char(64)
  notes              String?                     @db.Text
  createdAt          DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                    @updatedAt @db.Timestamptz(3)

  clinic             Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patient            Patient                     @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  package            TreatmentPackage            @relation(fields: [clinicId, packageId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  packageVersion     TreatmentPackageVersion     @relation(fields: [clinicId, packageVersionId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice            Invoice?                    @relation(fields: [clinicId, invoiceId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  entitlements       PatientPackageEntitlement[]
  redemptions        PackageRedemption[]
  installmentPlans   InstallmentPlan[]
  refundRequests     RefundRequest[]

  @@unique([clinicId, id])
  @@unique([clinicId, requestKey])
  @@index([clinicId, patientId, status])
  @@index([clinicId, status, expiresAt])
}

model PatientPackageEntitlement {
  id                 String                      @id @default(uuid()) @db.Uuid
  clinicId           String                      @db.Uuid
  patientPackageId   String                      @db.Uuid
  packageItemId      String?                     @db.Uuid
  procedureId        String?                     @db.Uuid
  serviceName        String                      @db.VarChar(120)
  totalSessions      Int
  redeemedSessions   Int                         @default(0)
  reservedSessions   Int                         @default(0)
  remainingSessions  Int
  version            Int                         @default(1)

  clinic             Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patientPackage     PatientPackage              @relation(fields: [clinicId, patientPackageId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  procedure          AestheticProcedureCatalog?  @relation(fields: [clinicId, procedureId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  redemptions        PackageRedemption[]

  @@unique([clinicId, id])
  @@index([clinicId, patientPackageId])
}

model PackageRedemption {
  id                     String                      @id @default(uuid()) @db.Uuid
  clinicId               String                      @db.Uuid
  patientPackageId       String                      @db.Uuid
  entitlementId          String                      @db.Uuid
  patientId              String                      @db.Uuid
  procedureExecutionId   String?                     @db.Uuid
  appointmentId          String?                     @db.Uuid
  visitId                String?                     @db.Uuid
  sessionsRedeemed       Int                         @default(1)
  status                 PackageRedemptionStatus     @default(RECORDED)
  redeemedAt             DateTime                    @default(now()) @db.Timestamptz(3)
  redeemedByMembershipId String                      @db.Uuid
  requestKey             String                      @db.Uuid
  requestHash            String                      @db.Char(64)
  notes                  String?                     @db.Text
  version                Int                         @default(1)
  createdAt              DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                    @updatedAt @db.Timestamptz(3)

  clinic                 Clinic                      @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patientPackage         PatientPackage              @relation(fields: [clinicId, patientPackageId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  entitlement            PatientPackageEntitlement   @relation(fields: [clinicId, entitlementId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  patient                Patient                     @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  procedureExecution     ProcedureExecution?         @relation(fields: [clinicId, procedureExecutionId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  appointment            Appointment?                @relation(fields: [clinicId, appointmentId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  visit                  Visit?                      @relation(fields: [clinicId, visitId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  redeemedBy             ClinicMembership            @relation("PackageRedeemer", fields: [clinicId, redeemedByMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  reversals              PackageRedemptionReversal[]

  @@unique([clinicId, id])
  @@unique([clinicId, requestKey])
  @@index([clinicId, patientPackageId, status])
  @@index([clinicId, patientId, redeemedAt])
}

model PackageRedemptionReversal {
  id                     String            @id @default(uuid()) @db.Uuid
  clinicId               String            @db.Uuid
  redemptionId           String            @db.Uuid
  reason                 String            @db.VarChar(500)
  reversedAt             DateTime          @default(now()) @db.Timestamptz(3)
  reversedByMembershipId String            @db.Uuid
  requestKey             String            @db.Uuid
  requestHash            String            @db.Char(64)

  clinic                 Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  redemption             PackageRedemption @relation(fields: [clinicId, redemptionId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy             ClinicMembership  @relation("PackageRedemptionReverser", fields: [clinicId, reversedByMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicId, id])
  @@unique([clinicId, requestKey])
  @@index([clinicId, redemptionId])
}

model InstallmentPlanCounter {
  id         String   @id @default(uuid()) @db.Uuid
  clinicId   String   @unique @db.Uuid
  lastNumber Int      @default(0)

  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model InstallmentPlan {
  id                   String                  @id @default(uuid()) @db.Uuid
  clinicId             String                  @db.Uuid
  patientId            String                  @db.Uuid
  invoiceId            String                  @db.Uuid
  patientPackageId     String?                 @db.Uuid
  planNumber           String                  @db.VarChar(50)
  totalAmountMinor     BigInt
  paidAmountMinor      BigInt                  @default(0)
  remainingAmountMinor BigInt
  currency             String                  @db.Char(3)
  currencyScale        Int
  numberOfInstallments Int
  status               InstallmentPlanStatus   @default(ACTIVE)
  notes                String?                 @db.Text
  version              Int                     @default(1)
  requestKey           String                  @db.Uuid
  requestHash          String                  @db.Char(64)
  createdAt            DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                @updatedAt @db.Timestamptz(3)

  clinic               Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patient              Patient                 @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice              Invoice                 @relation(fields: [clinicId, invoiceId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  patientPackage       PatientPackage?         @relation(fields: [clinicId, patientPackageId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  schedules            InstallmentSchedule[]
  allocations          InstallmentAllocation[]

  @@unique([clinicId, id])
  @@unique([clinicId, planNumber])
  @@unique([clinicId, requestKey])
  @@index([clinicId, patientId, status])
  @@index([clinicId, invoiceId])
}

model InstallmentSchedule {
  id                  String                    @id @default(uuid()) @db.Uuid
  clinicId            String                    @db.Uuid
  planId              String                    @db.Uuid
  installmentNumber   Int
  dueDate             DateTime                  @db.Timestamptz(3)
  expectedAmountMinor BigInt
  paidAmountMinor     BigInt                    @default(0)
  status              InstallmentScheduleStatus @default(PENDING)
  paidAt              DateTime?                 @db.Timestamptz(3)
  version             Int                       @default(1)

  clinic              Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  plan                InstallmentPlan           @relation(fields: [clinicId, planId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  allocations         InstallmentAllocation[]

  @@unique([clinicId, id])
  @@unique([clinicId, planId, installmentNumber])
  @@index([clinicId, dueDate, status])
}

model InstallmentAllocation {
  id                      String              @id @default(uuid()) @db.Uuid
  clinicId                String              @db.Uuid
  planId                  String              @db.Uuid
  scheduleId              String              @db.Uuid
  paymentId               String              @db.Uuid
  allocatedMinor          BigInt
  allocatedAt             DateTime            @default(now()) @db.Timestamptz(3)
  allocatedByMembershipId String              @db.Uuid
  notes                   String?             @db.Text

  clinic                  Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  plan                    InstallmentPlan     @relation(fields: [clinicId, planId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  schedule                InstallmentSchedule @relation(fields: [clinicId, scheduleId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  payment                 Payment             @relation(fields: [clinicId, paymentId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  allocatedBy             ClinicMembership    @relation("InstallmentAllocator", fields: [clinicId, allocatedByMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicId, id])
  @@unique([clinicId, scheduleId, paymentId])
  @@index([clinicId, planId])
}

model RefundRequest {
  id                      String              @id @default(uuid()) @db.Uuid
  clinicId                String              @db.Uuid
  invoiceId               String              @db.Uuid
  patientId               String              @db.Uuid
  patientPackageId        String?             @db.Uuid
  requestedAmountMinor    BigInt
  currency                String              @db.Char(3)
  currencyScale           Int
  reason                  FinancialReason
  reasonDetails           String              @db.VarChar(500)
  status                  RefundRequestStatus @default(REQUESTED)
  requestedByMembershipId String              @db.Uuid
  approvedByMembershipId  String?             @db.Uuid
  approvedAt              DateTime?           @db.Timestamptz(3)
  rejectedByMembershipId  String?             @db.Uuid
  rejectedAt              DateTime?           @db.Timestamptz(3)
  rejectionReason         String?             @db.VarChar(500)
  settledAt               DateTime?           @db.Timestamptz(3)
  settledByMembershipId   String?             @db.Uuid
  settlementReference     String?             @db.VarChar(100)
  paymentReversalId       String?             @db.Uuid
  version                 Int                 @default(1)
  requestKey              String              @db.Uuid
  requestHash             String              @db.Char(64)
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)

  clinic                  Clinic              @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invoice                 Invoice             @relation(fields: [clinicId, invoiceId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  patient                 Patient             @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  patientPackage          PatientPackage?     @relation(fields: [clinicId, patientPackageId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  reversal                PaymentReversal?    @relation(fields: [clinicId, paymentReversalId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  requestedBy             ClinicMembership    @relation("RefundRequester", fields: [clinicId, requestedByMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedBy              ClinicMembership?   @relation("RefundApprover", fields: [clinicId, approvedByMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  rejectedBy              ClinicMembership?   @relation("RefundRejecter", fields: [clinicId, rejectedByMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  settledBy               ClinicMembership?   @relation("RefundSettler", fields: [clinicId, settledByMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicId, id])
  @@unique([clinicId, requestKey])
  @@index([clinicId, invoiceId, status])
  @@index([clinicId, patientId, status])
}
