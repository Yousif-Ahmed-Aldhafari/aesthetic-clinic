generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

// Platform authority is global and never confers clinic membership access.
enum PlatformRole {
  PLATFORM_ADMIN
}

enum ClinicRole {
  CLINIC_OWNER
  CLINIC_ADMIN
  DOCTOR
  RECEPTIONIST
  ACCOUNTANT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

// Tenant root: scoped private SELECT; fixed public/identity bootstrap functions.
model Clinic {
  id             String             @id @default(uuid()) @db.Uuid
  legalName      String             @db.VarChar(200)
  displayName    String             @db.VarChar(150)
  englishName    String?            @db.VarChar(150)
  contactPhone   String?            @db.VarChar(16)
  contactEmail   String?            @db.VarChar(254)
  address        String?            @db.VarChar(250)
  latitude       Decimal?           @db.Decimal(9, 6)
  longitude      Decimal?           @db.Decimal(9, 6)
  version        Int                @default(1)
  slug           String             @unique @db.VarChar(63)
  status         ClinicStatus       @default(ACTIVE)
  mfaPolicy      ClinicMfaPolicy    @default(OWNER_ONLY)
  timezone       String             @default("UTC") @db.VarChar(100)
  currency       String             @db.Char(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  branding       ClinicBranding?
  domains        ClinicDomain[]
  memberships    ClinicMembership[]
  sessions       Session[]
  patients       Patient[]
  patientCounter PatientCounter?
  services ClinicService[]
  resources BookableResource[]
  appointments Appointment[]
  availability ResourceAvailability[]
  timeOff ResourceTimeOff[]
  schedulingState SchedulingState?
  visits Visit[]
  queueTickets QueueTicket[]
  queueCounters QueueCounter[]
  queueConfiguration QueueConfiguration?
  queueCommands QueueCommand[]
  invoices Invoice[]
  invoiceLines InvoiceLine[]
  payments Payment[]
  paymentReversals PaymentReversal[]
  financialAuditEvents FinancialAuditEvent[]
  invoiceCounter ClinicInvoiceCounter?
  billingProfile ClinicBillingProfile?
  assets ClinicAsset[]
  identityState ClinicIdentityState?
  identityAuditEvents ClinicIdentityAuditEvent[]
  slugReservations ClinicSlugReservation[]
  auditEvents AuditEvent[]
  privacyRequests PrivacyRequest[]
  patientExports PatientExport[]
  retentionPolicy RetentionPolicy?
  clinicalEncounters ClinicalEncounter[]
  clinicalNotes ClinicalNote[]
  clinicalNoteAmendments ClinicalNoteAmendment[]
  medicalHistories MedicalHistory[]
  procedureCatalog AestheticProcedureCatalog[]
  treatmentPlans TreatmentPlan[]
  treatmentPlanRevisions TreatmentPlanRevision[]
  treatmentPlanItems TreatmentPlanItem[]
  procedureExecutions ProcedureExecution[]
  consentTemplates ConsentTemplate[]
  consentTemplateVersions ConsentTemplateVersion[]
  patientConsents PatientConsent[]
  consentSignatureEvidence ConsentSignatureEvidence[]
  consentWithdrawals ConsentWithdrawal[]
  clinicalPhotoSessions ClinicalPhotoSession[]
  clinicalPhotos ClinicalPhoto[]
  photoComparisonGroups PhotoComparisonGroup[]
  photoAnnotations PhotoAnnotation[]
  clinicalFollowUps ClinicalFollowUp[]
  followUpAssessments FollowUpAssessment[]
  followUpAssessmentAmendments FollowUpAssessmentAmendment[]
  treatmentOutcomes TreatmentOutcome[]
  adverseEvents AdverseEvent[]
  inventoryProducts InventoryProduct[]
  inventoryLocations InventoryLocation[]
  inventoryStockMovements InventoryStockMovement[]
  inventoryBalances InventoryBalance[]
  inventoryBatches InventoryBatch[]
  inventoryBatchBalances InventoryBatchBalance[]
  inventoryClinicalConsumptions InventoryClinicalConsumption[]
  inventorySuppliers InventorySupplier[]
  inventoryPurchaseOrders InventoryPurchaseOrder[]
  inventoryPurchaseOrderLines InventoryPurchaseOrderLine[]
  inventoryPurchaseOrderCounter InventoryPurchaseOrderCounter?
  inventoryGoodsReceipts InventoryGoodsReceipt[]
  inventoryGoodsReceiptLines InventoryGoodsReceiptLine[]
  inventoryGoodsReceiptCounter InventoryGoodsReceiptCounter?
  inventoryStockCounts InventoryStockCount[]
  inventoryStockCountItems InventoryStockCountItem[]
  inventoryStockCountCounter InventoryStockCountCounter?
  inventoryAlertAcknowledgments InventoryAlertAcknowledgment[]
  treatmentPackages TreatmentPackage[]
  treatmentPackageVersions TreatmentPackageVersion[]
  treatmentPackageItems TreatmentPackageItem[]
  patientPackages PatientPackage[]
  patientPackageEntitlements PatientPackageEntitlement[]
  packageRedemptions PackageRedemption[]
  packageRedemptionReversals PackageRedemptionReversal[]
  installmentPlans InstallmentPlan[]
  installmentSchedules InstallmentSchedule[]
  installmentAllocations InstallmentAllocation[]
  installmentPlanCounter InstallmentPlanCounter?
  refundRequests RefundRequest[]

  @@index([status, createdAt])
}

// Tenant resource: FORCE RLS and immutable clinicId.
model ClinicBranding {
  clinicId       String   @id @db.Uuid
  logoUrl        String?  @db.VarChar(2048)
  primaryColor   String   @default("#7854D9") @db.VarChar(7)
  secondaryColor String   @default("#F6F8FC") @db.VarChar(7)
  accentColor    String?  @db.VarChar(7)
  faviconUrl     String?  @db.VarChar(2048)
  typography     String   @default("TAJAWAL") @db.VarChar(20)
  logoAssetId    String?  @db.Uuid
  faviconAssetId String?  @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  logoAsset ClinicAsset? @relation("ClinicLogo", fields: [clinicId, logoAssetId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  faviconAsset ClinicAsset? @relation("ClinicFavicon", fields: [clinicId, faviconAssetId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
}

// Tenant resource: FORCE RLS and immutable clinicId.
model ClinicDomain {
  id                 String                   @id @default(uuid()) @db.Uuid
  clinicId           String                   @db.Uuid
  hostname           String                   @unique @db.VarChar(253)
  verificationStatus DomainVerificationStatus @default(PENDING)
  isPrimary          Boolean                  @default(false)
  challengeHash      String?                  @db.Char(64)
  challengeExpiresAt DateTime?                @db.Timestamptz(3)
  verifiedAt         DateTime?                @db.Timestamptz(3)
  lastCheckedAt      DateTime?                @db.Timestamptz(3)
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)
  clinic             Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicId, id])
  @@index([clinicId, verificationStatus])
}

// Immutable encoded derivatives only; originals are never stored or published.
model ClinicAsset {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  purpose String @db.VarChar(10)
  storageKey String @unique @db.VarChar(100)
  mimeType String @db.VarChar(20)
  byteSize Int
  width Int
  height Int
  sha256 String @db.Char(64)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  logoFor ClinicBranding[] @relation("ClinicLogo")
  faviconFor ClinicBranding[] @relation("ClinicFavicon")
  @@unique([clinicId,id])
  @@index([clinicId,publishedAt,createdAt])
}

// Retain former platform names to prevent another clinic claiming old links.
// Only explicit owner maintenance can remove a clinic; no runtime delete path.
model ClinicSlugReservation {
  slug String @id @db.VarChar(63)
  clinicId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Cascade,onUpdate:Restrict)
  @@index([clinicId,createdAt])
}

// Trigger-owned serialization/hash-chain head; runtime cannot mutate it directly.
model ClinicIdentityState {
  clinicId String @id @db.Uuid
  lastSequence Int @default(0)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
}

model ClinicIdentityAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  sequence Int
  actorUserId String @db.Uuid
  actorMembershipId String @db.Uuid
  action String @db.VarChar(60)
  targetId String @db.Uuid
  payload String @db.Text
  previousHash String @db.Char(64)
  eventHash String @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([clinicId,sequence])
  @@index([clinicId,createdAt,id])
}

// Global identity: auth-only read path; runtime cannot write users.
model User {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @db.VarChar(150)
  email        String             @unique @db.VarChar(254)
  passwordHash String?            @db.VarChar(255)
  status       UserStatus         @default(INVITED)
  platformRole PlatformRole?
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  memberships  ClinicMembership[]
  authVersion   Int                @default(0)
  sessions      Session[]
  mfa           UserMfa?
  mfaChallenges MfaChallenge[]
}

// Tenant resource and identity bridge: scoped SELECT, maintenance-only writes.
model ClinicMembership {
  id        String           @id @default(uuid()) @db.Uuid
  clinicId  String           @db.Uuid
  userId    String           @db.Uuid
  role      ClinicRole
  status    MembershipStatus @default(INVITED)
  version   Int              @default(1)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  clinic    Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  bookableResource BookableResource?
  financialAuditEvents FinancialAuditEvent[]
  clinicalEncounters ClinicalEncounter[] @relation("EncounterClinician")
  authoredClinicalNotes ClinicalNote[] @relation("ClinicalNoteAuthor")
  clinicalNoteAmendments ClinicalNoteAmendment[] @relation("ClinicalAmendmentAuthor")
  reviewedMedicalHistories MedicalHistory[] @relation("MedicalHistoryReviewer")
  authoredTreatmentPlans TreatmentPlan[] @relation("TreatmentPlanClinician")
  authoredTreatmentRevisions TreatmentPlanRevision[] @relation("TreatmentRevisionAuthor")
  approvedTreatmentRevisions TreatmentPlanRevision[] @relation("TreatmentRevisionApprover")
  procedureExecutions ProcedureExecution[] @relation("ProcedureClinician")
  publishedConsentTemplateVersions ConsentTemplateVersion[] @relation("ConsentTemplateVersionPublisher")
  preparedPatientConsents PatientConsent[] @relation("ConsentPreparer")
  verifiedPatientConsents PatientConsent[] @relation("ConsentVerifier")
  withdrawnPatientConsents ConsentWithdrawal[] @relation("ConsentWithdrawer")
  clinicalPhotoSessions ClinicalPhotoSession[] @relation("PhotoSessionClinician")
  clinicalPhotos ClinicalPhoto[] @relation("PhotoClinician")
  photoComparisonGroups PhotoComparisonGroup[] @relation("PhotoComparisonClinician")
  photoAnnotations PhotoAnnotation[] @relation("PhotoAnnotationAuthor")
  treatingFollowUps ClinicalFollowUp[] @relation("FollowUpTreatingDoctor")
  authoredAssessments FollowUpAssessment[] @relation("FollowUpAssessmentDoctor")
  authoredAssessmentAmendments FollowUpAssessmentAmendment[] @relation("AssessmentAmendmentAuthor")
  recordedOutcomes TreatmentOutcome[] @relation("OutcomeRecorder")
  reportedAdverseEvents AdverseEvent[] @relation("AdverseEventReporter")
  inventoryMovements InventoryStockMovement[] @relation("InventoryActor")
  inventoryConsumptions InventoryClinicalConsumption[] @relation("ConsumptionActor")
  purchaseOrdersCreated InventoryPurchaseOrder[] @relation("POCreator")
  purchaseOrdersApproved InventoryPurchaseOrder[] @relation("POApprover")
  goodsReceiptsReceived InventoryGoodsReceipt[] @relation("GRReceiver")
  stockCountsCounted InventoryStockCount[] @relation("SCCounter")
  stockCountsApproved InventoryStockCount[] @relation("SCApprover")
  alertAcknowledgments InventoryAlertAcknowledgment[]
  packageVersionsPublished TreatmentPackageVersion[] @relation("PackageVersionPublisher")
  packageRedemptions PackageRedemption[] @relation("PackageRedeemer")
  packageRedemptionReversals PackageRedemptionReversal[] @relation("PackageRedemptionReverser")
  installmentAllocations InstallmentAllocation[] @relation("InstallmentAllocator")
  refundRequestsMade RefundRequest[] @relation("RefundRequester")
  refundRequestsApproved RefundRequest[] @relation("RefundApprover")
  refundRequestsRejected RefundRequest[] @relation("RefundRejecter")
  refundRequestsSettled RefundRequest[] @relation("RefundSettler")

  // One current role per user/clinic; the same user can join many clinics.
  @@unique([clinicId, userId])
  @@unique([clinicId, id])
  @@index([userId, status])
  @@index([clinicId, status, role])
}

// Global identity infrastructure, never an authorization grant for a clinic.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique @db.Char(64)
  csrfHash          String    @db.Char(64)
  authorizationHash String    @db.Char(64)
  selectedClinicId  String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime  @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  mfaVerifiedAt     DateTime? @db.Timestamptz(3)
  userAgent         String?   @db.VarChar(255)
  ipAddress         String?   @db.VarChar(45)
  deviceSummary     String?   @db.VarChar(100)
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  selectedClinic    Clinic?   @relation(fields: [selectedClinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

enum ClinicMfaPolicy {
  OWNER_ONLY
  ADMINS_AND_OWNER
  ALL_STAFF
  OPTIONAL
}

enum MfaStatus {
  PENDING
  ACTIVE
  DISABLED
}

model UserMfa {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @unique @db.Uuid
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  totpSecretEnc  String            @db.Text
  totpIv         String            @db.VarChar(32)
  totpTag        String            @db.VarChar(32)
  status         MfaStatus         @default(PENDING)
  enrolledAt     DateTime?         @db.Timestamptz(3)
  lastUsedAt     DateTime?         @db.Timestamptz(3)
  lastReplayStep BigInt?           @db.BigInt
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)
  recoveryCodes  MfaRecoveryCode[]
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  mfaId     String    @db.Uuid
  mfa       UserMfa   @relation(fields: [mfaId], references: [id], onDelete: Cascade)
  codeHash  String    @db.Char(64)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([mfaId, usedAt])
}

model MfaChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @db.Char(64)
  expiresAt  DateTime  @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tokenHash, expiresAt])
  @@index([userId, consumedAt])
}

// Global security infrastructure; no tenant access grant.
model LoginBucket {
  key       String   @id @db.Char(64)
  attempts  Int      @default(1)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

// Optional, self-reported administrative gender, never inferred or clinical sex.
enum PatientGender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

// Administrative identity/contact only. No clinical/free-text notes or media.
model Patient {
  id            String         @id @default(uuid()) @db.Uuid
  clinicId      String         @db.Uuid
  patientNumber String         @db.VarChar(20)
  fullName      String         @db.VarChar(150)
  searchName    String         @db.VarChar(150)
  phone         String?        @db.VarChar(16)
  email         String?        @db.VarChar(254)
  dateOfBirth   DateTime?      @db.Date
  gender        PatientGender?
  status        PatientStatus  @default(ACTIVE)
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  clinic        Clinic         @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicId, id])
  appointments Appointment[]
  visits Visit[]
  invoices Invoice[]
  clinicalEncounters ClinicalEncounter[]
  medicalHistory MedicalHistory?
  treatmentPlans TreatmentPlan[]
  procedureExecutions ProcedureExecution[]
  consents PatientConsent[]
  clinicalPhotoSessions ClinicalPhotoSession[]
  clinicalPhotos ClinicalPhoto[]
  photoComparisonGroups PhotoComparisonGroup[]
  clinicalFollowUps ClinicalFollowUp[]
  treatmentOutcomes TreatmentOutcome[]
  adverseEvents AdverseEvent[]
  patientPackages PatientPackage[]
  packageRedemptions PackageRedemption[]
  installmentPlans InstallmentPlan[]
  refundRequests RefundRequest[]

  @@unique([clinicId, patientNumber])
  @@index([clinicId, createdAt, id])
  @@index([clinicId, status, createdAt, id])
  @@index([clinicId, searchName])
  @@index([clinicId, phone])
}

// Row-locked transactional allocator; runtime cannot delete or decrement it.
model PatientCounter {
  clinicId   String @id @db.Uuid
  lastNumber Int
  clinic     Clinic @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

enum ClinicalEncounterStatus {
  DRAFT
  IN_PROGRESS
  SIGNED
  AMENDED
  CLOSED
}

enum ClinicalNoteStatus {
  DRAFT
  SIGNED
  AMENDED
}

enum ClinicalNoteType {
  CONSULTATION
}

model ClinicalEncounter {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  patientId String @db.Uuid
  clinicianMembershipId String @db.Uuid
  visitId String? @db.Uuid
  appointmentId String? @db.Uuid
  status ClinicalEncounterStatus @default(DRAFT)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  patient Patient @relation(fields:[clinicId,patientId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  clinician ClinicMembership @relation("EncounterClinician",fields:[clinicId,clinicianMembershipId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  visit Visit? @relation(fields:[clinicId,visitId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  appointment Appointment? @relation(fields:[clinicId,appointmentId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  notes ClinicalNote[]
  treatmentPlans TreatmentPlan[]
  procedureExecutions ProcedureExecution[]
  photoSessions ClinicalPhotoSession[]
  followUps ClinicalFollowUp[]
  @@unique([clinicId,id])
  @@unique([clinicId,visitId])
  @@index([clinicId,patientId,createdAt,id])
  @@index([clinicId,clinicianMembershipId,status,createdAt])
}

model ClinicalNote {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  encounterId String @db.Uuid
  authorMembershipId String @db.Uuid
  noteType ClinicalNoteType @default(CONSULTATION)
  content Json
  status ClinicalNoteStatus @default(DRAFT)
  version Int @default(1)
  signedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  encounter ClinicalEncounter @relation(fields:[clinicId,encounterId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  author ClinicMembership @relation("ClinicalNoteAuthor",fields:[clinicId,authorMembershipId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  amendments ClinicalNoteAmendment[]
  @@unique([clinicId,id])
  @@index([clinicId,encounterId,createdAt])
  @@index([clinicId,authorMembershipId,status])
}

model ClinicalNoteAmendment {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  noteId String @db.Uuid
  authorMembershipId String @db.Uuid
  reason String @db.VarChar(1000)
  content Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  note ClinicalNote @relation(fields:[clinicId,noteId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  author ClinicMembership @relation("ClinicalAmendmentAuthor",fields:[clinicId,authorMembershipId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([clinicId,id])
  @@index([clinicId,noteId,createdAt,id])
}

model MedicalHistory {
  clinicId String @db.Uuid
  patientId String @db.Uuid
  content Json
  version Int @default(1)
  reviewedByMembershipId String? @db.Uuid
  reviewedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  patient Patient @relation(fields:[clinicId,patientId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  reviewedBy ClinicMembership? @relation("MedicalHistoryReviewer",fields:[clinicId,reviewedByMembershipId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  @@id([clinicId,patientId])
  @@index([clinicId,reviewedAt])
}

enum TreatmentPlanStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}
enum TreatmentRevisionStatus {
  DRAFT
  APPROVED
}
enum TreatmentItemStatus {
  PLANNED
  READY
  CANCELLED
  COMPLETED
}
enum ProcedureExecutionStatus {
  DRAFT
  READY
  PERFORMED
  COMPLETED
  CANCELLED
}

model AestheticProcedureCatalog {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  nameAr String @db.VarChar(150)
  nameEn String? @db.VarChar(150)
  description String? @db.VarChar(2000)
  category String @db.VarChar(100)
  defaultDurationMinutes Int?
  requirements String? @db.VarChar(4000)
  clinicServiceId String? @db.Uuid
  active Boolean @default(true)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  clinicService ClinicService? @relation(fields:[clinicId,clinicServiceId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  planItems TreatmentPlanItem[]
  consentTemplates ConsentTemplate[]
  consents PatientConsent[]
  treatmentPackageItems TreatmentPackageItem[]
  patientPackageEntitlements PatientPackageEntitlement[]
  @@unique([clinicId,id])
  @@index([clinicId,active,nameAr,id])
  @@index([clinicId,clinicServiceId])
}

model TreatmentPlan {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  patientId String @db.Uuid
  clinicianMembershipId String @db.Uuid
  originatingEncounterId String? @db.Uuid
  status TreatmentPlanStatus @default(DRAFT)
  currentRevisionNumber Int @default(1)
  version Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  patient Patient @relation(fields:[clinicId,patientId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
  clinician ClinicMembership @relation("TreatmentPlanClinician",fields:[clinicId,clinicianMembershipId],references:[clinicId,id],onDelete:Restrict,onUpdate:Restrict)
