  RETURN
}

enum InventoryBatchStatus {
  AVAILABLE
  QUARANTINED
  RECALLED
  EXPIRED
  DEPLETED
}

enum ClinicalConsumptionStatus {
  RECORDED
  VOIDED
}

model InventoryProduct {
  id                    String                   @id @default(uuid()) @db.Uuid
  clinicId              String                   @db.Uuid
  sku                   String                   @db.VarChar(64)
  nameAr                String                   @db.VarChar(200)
  nameEn                String?                  @db.VarChar(200)
  category              InventoryCategory
  description           String?                  @db.VarChar(1000)
  unit                  InventoryUnit
  requiresBatchTracking Boolean                  @default(false)
  reorderThreshold      Decimal                  @default(0) @db.Decimal(12, 4)
  isActive              Boolean                  @default(true)
  version               Int                      @default(1)
  createdAt             DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                 @updatedAt @db.Timestamptz(3)

  clinic                Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movements             InventoryStockMovement[]
  balances              InventoryBalance[]
  batches               InventoryBatch[]
  batchBalances         InventoryBatchBalance[]
  clinicalConsumptions  InventoryClinicalConsumption[]
  purchaseOrderLines    InventoryPurchaseOrderLine[]
  goodsReceiptLines     InventoryGoodsReceiptLine[]
  stockCountItems       InventoryStockCountItem[]

  @@unique([clinicId, id])
  @@unique([clinicId, sku])
  @@index([clinicId, category, isActive])
  @@index([clinicId, isActive])
}

model InventoryLocation {
  id              String                   @id @default(uuid()) @db.Uuid
  clinicId        String                   @db.Uuid
  code            String                   @db.VarChar(32)
  nameAr          String                   @db.VarChar(150)
  nameEn          String?                  @db.VarChar(150)
  type            InventoryLocationType    @default(MAIN_STORE)
  description     String?                  @db.VarChar(500)
  isActive        Boolean                  @default(true)
  version         Int                      @default(1)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                 @updatedAt @db.Timestamptz(3)

  clinic          Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  movements       InventoryStockMovement[] @relation("LocationMovements")
  sourceMovements InventoryStockMovement[] @relation("SourceLocationMovements")
  balances        InventoryBalance[]
  batchBalances   InventoryBatchBalance[]
  clinicalConsumptions InventoryClinicalConsumption[]
  destinationPurchaseOrders InventoryPurchaseOrder[]
  destinationGoodsReceipts  InventoryGoodsReceipt[]
  goodsReceiptLines         InventoryGoodsReceiptLine[]
  stockCounts               InventoryStockCount[]

  @@unique([clinicId, id])
  @@unique([clinicId, code])
  @@index([clinicId, type, isActive])
}

model InventoryBatch {
  id               String                  @id @default(uuid()) @db.Uuid
  clinicId         String                  @db.Uuid
  productId        String                  @db.Uuid
  batchNumber      String                  @db.VarChar(100)
  expirationDate   DateTime                @db.Date
  status           InventoryBatchStatus    @default(AVAILABLE)
