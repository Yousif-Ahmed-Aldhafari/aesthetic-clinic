generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ClinicBranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InterBranchTransferStatus {
  PENDING
  DISPATCHED
  RECEIVED
  CANCELLED
}

enum DomainVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

// Platform authority is global and never confers clinic membership access.
enum PlatformRole {
  PLATFORM_ADMIN
}

enum ClinicRole {
  CLINIC_OWNER
  CLINIC_ADMIN
  DOCTOR
  RECEPTIONIST
  ACCOUNTANT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

// Tenant root: scoped private SELECT; fixed public/identity bootstrap functions.
model Clinic {
  id             String             @id @default(uuid()) @db.Uuid
  legalName      String             @db.VarChar(200)
  displayName    String             @db.VarChar(150)
  englishName    String?            @db.VarChar(150)
  contactPhone   String?            @db.VarChar(16)
  contactEmail   String?            @db.VarChar(254)
  address        String?            @db.VarChar(250)
  latitude       Decimal?           @db.Decimal(9, 6)
  longitude      Decimal?           @db.Decimal(9, 6)
  version        Int                @default(1)
  slug           String             @unique @db.VarChar(63)
  status         ClinicStatus       @default(ACTIVE)
  mfaPolicy      ClinicMfaPolicy    @default(OWNER_ONLY)
  timezone       String             @default("UTC") @db.VarChar(100)
  currency       String             @db.Char(3)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  branding       ClinicBranding?
  domains        ClinicDomain[]
  memberships    ClinicMembership[]
  sessions       Session[]
  patients       Patient[]
  patientCounter PatientCounter?
  services ClinicService[]
  resources BookableResource[]
  appointments Appointment[]
  availability ResourceAvailability[]
  timeOff ResourceTimeOff[]
  schedulingState SchedulingState?
  visits Visit[]
  queueTickets QueueTicket[]
  queueCounters QueueCounter[]
  queueConfiguration QueueConfiguration?
  queueCommands QueueCommand[]
  invoices Invoice[]
  invoiceLines InvoiceLine[]
  payments Payment[]
  paymentReversals PaymentReversal[]
  financialAuditEvents FinancialAuditEvent[]
  invoiceCounter ClinicInvoiceCounter?
  billingProfile ClinicBillingProfile?
  assets ClinicAsset[]
  identityState ClinicIdentityState?
  identityAuditEvents ClinicIdentityAuditEvent[]
  slugReservations ClinicSlugReservation[]
  auditEvents AuditEvent[]
  privacyRequests PrivacyRequest[]
  patientExports PatientExport[]
  retentionPolicy RetentionPolicy?
  clinicalEncounters ClinicalEncounter[]
  clinicalNotes ClinicalNote[]
  clinicalNoteAmendments ClinicalNoteAmendment[]
  medicalHistories MedicalHistory[]
  procedureCatalog AestheticProcedureCatalog[]
  treatmentPlans TreatmentPlan[]
  treatmentPlanRevisions TreatmentPlanRevision[]
  treatmentPlanItems TreatmentPlanItem[]
  procedureExecutions ProcedureExecution[]
  consentTemplates ConsentTemplate[]
  consentTemplateVersions ConsentTemplateVersion[]
  patientConsents PatientConsent[]
  consentSignatureEvidence ConsentSignatureEvidence[]
  consentWithdrawals ConsentWithdrawal[]
  clinicalPhotoSessions ClinicalPhotoSession[]
  clinicalPhotos ClinicalPhoto[]
  photoComparisonGroups PhotoComparisonGroup[]
  photoAnnotations PhotoAnnotation[]
  clinicalFollowUps ClinicalFollowUp[]
  followUpAssessments FollowUpAssessment[]
  followUpAssessmentAmendments FollowUpAssessmentAmendment[]
  treatmentOutcomes TreatmentOutcome[]
  adverseEvents AdverseEvent[]
  inventoryProducts InventoryProduct[]
  inventoryLocations InventoryLocation[]
  inventoryStockMovements InventoryStockMovement[]
  inventoryBalances InventoryBalance[]
  inventoryBatches InventoryBatch[]
  inventoryBatchBalances InventoryBatchBalance[]
  inventoryClinicalConsumptions InventoryClinicalConsumption[]
  inventorySuppliers InventorySupplier[]
  inventoryPurchaseOrders InventoryPurchaseOrder[]
  inventoryPurchaseOrderLines InventoryPurchaseOrderLine[]
  inventoryPurchaseOrderCounter InventoryPurchaseOrderCounter?
  inventoryGoodsReceipts InventoryGoodsReceipt[]
  inventoryGoodsReceiptLines InventoryGoodsReceiptLine[]
  inventoryGoodsReceiptCounter InventoryGoodsReceiptCounter?
  inventoryStockCounts InventoryStockCount[]
  inventoryStockCountItems InventoryStockCountItem[]
  inventoryStockCountCounter InventoryStockCountCounter?
  inventoryAlertAcknowledgments InventoryAlertAcknowledgment[]
  treatmentPackages TreatmentPackage[]
  treatmentPackageVersions TreatmentPackageVersion[]
  treatmentPackageItems TreatmentPackageItem[]
  patientPackages PatientPackage[]
  patientPackageEntitlements PatientPackageEntitlement[]
  packageRedemptions PackageRedemption[]
  packageRedemptionReversals PackageRedemptionReversal[]
  installmentPlans InstallmentPlan[]
  installmentSchedules InstallmentSchedule[]
  installmentAllocations InstallmentAllocation[]
  installmentPlanCounter InstallmentPlanCounter?
  refundRequests RefundRequest[]
  commissionPlans PractitionerCommissionPlan[]
  commissionAssignments PractitionerCommissionAssignment[]
  commissionRules PractitionerCommissionRule[]
  commissionSettlementCounter CommissionSettlementCounter?
  commissionSettlements PractitionerCommissionSettlement[]
  commissionAccruals PractitionerCommissionAccrual[]
  commissionAdjustments PractitionerCommissionAdjustment[]
  patientAccounts PatientAccount[]
  patientSessions PatientSession[]
  patientVerificationTokens PatientVerificationToken[]
  patientPortalAuditEvents PatientPortalAuditEvent[]
  recoveryCheckIns PatientRecoveryCheckIn[]
  patientReportedOutcomes PatientReportedOutcome[]
  branches ClinicBranch[]
  branchMemberships BranchMembership[]
  interBranchTransfers InterBranchTransfer[]
  costLayers InventoryCostLayer[]
  landedCosts InventoryLandedCost[]
  landedCostAllocationLines InventoryLandedCostAllocationLine[]
  costMovements InventoryCostMovement[]
  valuationSnapshots InventoryValuationSnapshot[]
  costAdjustments InventoryCostAdjustment[]
  landedCostCounter InventoryLandedCostCounter?
  costMovementCounter InventoryCostMovementCounter?
  valuationSnapshotCounter InventoryValuationSnapshotCounter?
  costAdjustmentCounter InventoryCostAdjustmentCounter?
  paymentProviderConfigs PaymentProviderConfiguration[]
  paymentIntents PaymentIntent[]
  paymentProviderEvents PaymentProviderEvent[]
  paymentSettlements PaymentSettlement[]
  externalRefunds ExternalRefund[]
  externalPayouts ExternalPayout[]
  externalReconciliationRuns ExternalReconciliationRun[]
  externalReconciliationFindings ExternalReconciliationFinding[]
  regulatoryProfile ClinicRegulatoryProfile?
  regulatoryDocuments RegulatoryDocument[]
  regulatorySubmissions RegulatorySubmission[]
  regulatorySubmissionEvents RegulatorySubmissionEvent[]
  externalPayoutCounter ExternalPayoutCounter?
  externalReconciliationRunCounter ExternalReconciliationRunCounter?
  regulatoryDocumentCounter RegulatoryDocumentCounter?
  clinicSpecialties ClinicSpecialty[]
  branchSpecialties BranchSpecialty[]
  practitionerProfiles PractitionerProfile[]
  practitionerSpecialties PractitionerSpecialty[]
  practitionerClinicalPrivileges PractitionerClinicalPrivilege[]
  clinicalObservations ClinicalObservation[]
  encounterDiagnoses EncounterDiagnosis[]
  patientAllergies PatientAllergy[]
  medicationRecords MedicationRecord[]
  medicationPrescriptions MedicationPrescription[]
  medicationPrescriptionItems MedicationPrescriptionItem[]
  clinicPrescriptionCounter ClinicPrescriptionCounter?
  generalClinicalServices GeneralClinicalService[]
  clinicOrderCounter ClinicOrderCounter?
  clinicalOrders ClinicalOrder[]
  clinicalOrderResults ClinicalOrderResult[]
  clinicalDocuments ClinicalDocument[]
  clinicalFormDefinitions ClinicalFormDefinition[]
  clinicalFormVersions ClinicalFormDefinitionVersion[]
  clinicalFormResponses ClinicalFormResponse[]
  clinicalFormAmendments ClinicalFormResponseAmendment[]
  clinicalSafetyPolicies ClinicalSafetyPolicy[]
  clinicalSafetyPolicyVersions ClinicalSafetyPolicyVersion[]
  clinicalIncidents ClinicalIncident[]
  clinicalIncidentCounter ClinicalIncidentCounter?
  emergencyBreakGlassAccesses EmergencyBreakGlassAccess[]
  practitionerPrivilegeReviews PractitionerPrivilegeReview[]
  dentalOdontograms DentalOdontogram[]
  dentalToothFindings DentalToothFinding[]
  dentalPeriodontalRecords DentalPeriodontalRecord[]
  dentalTreatmentStages DentalTreatmentStage[]
  pediatricBirthHistories PediatricBirthHistory[]
  caregiverRelationships PatientCaregiverRelationship[]
  pediatricGrowthRecords PediatricGrowthRecord[]
  pregnancyEpisodes PregnancyEpisode[]
  antenatalVisits AntenatalVisitRecord[]
  obstetricHistories ObstetricHistoryRecord[]
  gynecologicalExams GynecologicalExamination[]
  ophthalmicRefractions OphthalmicRefractionRecord[]
  ophthalmicExams OphthalmicExaminationRecord[]
  entExams EntExaminationRecord[]
  audiometryAssessments AudiometryAssessmentRecord[]
  musculoskeletalExaminations MusculoskeletalExamination[]
  jointRangeOfMotionRecords JointRangeOfMotionRecord[]
  physiotherapyRehabilitationEpisodes PhysiotherapyRehabilitationEpisode[]
  physiotherapySessionRecords PhysiotherapySessionRecord[]

  @@index([status, createdAt])
}

model ClinicBranch {
  id             String             @id @default(uuid()) @db.Uuid
  clinicId       String             @db.Uuid
  code           String             @db.VarChar(50)
  nameAr         String             @db.VarChar(200)
  nameEn         String?            @db.VarChar(200)
  phone          String?            @db.VarChar(50)
  email          String?            @db.VarChar(254)
  address        String?            @db.VarChar(500)
  latitude       Decimal?           @db.Decimal(9, 6)
  longitude      Decimal?           @db.Decimal(9, 6)
  timezone       String             @default("UTC") @db.VarChar(100)
  operatingHours Json?
  status         ClinicBranchStatus @default(ACTIVE)
  version        Int                @default(1)
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  clinic         Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberships    BranchMembership[]
  resources      BookableResource[]
  appointments   Appointment[]
  visits         Visit[]
  inventoryLocations InventoryLocation[]
  invoices       Invoice[]
  sessions       Session[]
  sourceTransfers InterBranchTransfer[] @relation("SourceBranchTransfers")
  destinationTransfers InterBranchTransfer[] @relation("DestinationBranchTransfers")
  costLayers InventoryCostLayer[]
  valuationSnapshots InventoryValuationSnapshot[]
  paymentIntents PaymentIntent[]
  branchSpecialties BranchSpecialty[]
  branchClinicalPrivileges PractitionerClinicalPrivilege[]
  generalClinicalServices GeneralClinicalService[]
  clinicalOrders ClinicalOrder[]
  clinicalFormResponses ClinicalFormResponse[]

  @@unique([clinicId, id])
  @@unique([clinicId, code])
  @@index([clinicId, status])
}

model BranchMembership {
  id           String             @id @default(uuid()) @db.Uuid
  clinicId     String             @db.Uuid
  branchId     String             @db.Uuid
  membershipId String             @db.Uuid
  isPrimary    Boolean            @default(false)
  active       Boolean            @default(true)
  version      Int                @default(1)
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)

  clinic       Clinic             @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch       ClinicBranch       @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  membership   ClinicMembership   @relation(fields: [clinicId, membershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicId, id])
  @@unique([clinicId, branchId, membershipId])
  @@index([clinicId, membershipId, active])
  @@index([clinicId, branchId, active])
}

// Tenant resource: FORCE RLS and immutable clinicId.
model ClinicBranding {
  clinicId       String   @id @db.Uuid
  logoUrl        String?  @db.VarChar(2048)
  primaryColor   String   @default("#7854D9") @db.VarChar(7)
  secondaryColor String   @default("#F6F8FC") @db.VarChar(7)
  accentColor    String?  @db.VarChar(7)
  faviconUrl     String?  @db.VarChar(2048)
  typography     String   @default("TAJAWAL") @db.VarChar(20)
  logoAssetId    String?  @db.Uuid
  faviconAssetId String?  @db.Uuid
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)
  clinic         Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  logoAsset ClinicAsset? @relation("ClinicLogo", fields: [clinicId, logoAssetId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  faviconAsset ClinicAsset? @relation("ClinicFavicon", fields: [clinicId, faviconAssetId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
}

// Tenant resource: FORCE RLS and immutable clinicId.
model ClinicDomain {
  id                 String                   @id @default(uuid()) @db.Uuid
  clinicId           String                   @db.Uuid
  hostname           String                   @unique @db.VarChar(253)
  verificationStatus DomainVerificationStatus @default(PENDING)
  isPrimary          Boolean                  @default(false)
  challengeHash      String?                  @db.Char(64)
  challengeExpiresAt DateTime?                @db.Timestamptz(3)
  verifiedAt         DateTime?                @db.Timestamptz(3)
  lastCheckedAt      DateTime?                @db.Timestamptz(3)
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)
  clinic             Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([clinicId, id])
  @@index([clinicId, verificationStatus])
}

// Immutable encoded derivatives only; originals are never stored or published.
model ClinicAsset {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  purpose String @db.VarChar(10)
  storageKey String @unique @db.VarChar(100)
  mimeType String @db.VarChar(20)
  byteSize Int
  width Int
  height Int
  sha256 String @db.Char(64)
  publishedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  logoFor ClinicBranding[] @relation("ClinicLogo")
  faviconFor ClinicBranding[] @relation("ClinicFavicon")
  @@unique([clinicId,id])
  @@index([clinicId,publishedAt,createdAt])
}

// Retain former platform names to prevent another clinic claiming old links.
// Only explicit owner maintenance can remove a clinic; no runtime delete path.
model ClinicSlugReservation {
  slug String @id @db.VarChar(63)
  clinicId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Cascade,onUpdate:Restrict)
  @@index([clinicId,createdAt])
}

// Trigger-owned serialization/hash-chain head; runtime cannot mutate it directly.
model ClinicIdentityState {
  clinicId String @id @db.Uuid
  lastSequence Int @default(0)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
}

model ClinicIdentityAuditEvent {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  sequence Int
  actorUserId String @db.Uuid
  actorMembershipId String @db.Uuid
  action String @db.VarChar(60)
  targetId String @db.Uuid
  payload String @db.Text
  previousHash String @db.Char(64)
  eventHash String @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic Clinic @relation(fields:[clinicId],references:[id],onDelete:Restrict,onUpdate:Restrict)
  @@unique([clinicId,sequence])
  @@index([clinicId,createdAt,id])
}

// Global identity: auth-only read path; runtime cannot write users.
model User {
  id           String             @id @default(uuid()) @db.Uuid
  name         String             @db.VarChar(150)
  email        String             @unique @db.VarChar(254)
  passwordHash String?            @db.VarChar(255)
  status       UserStatus         @default(INVITED)
  platformRole PlatformRole?
  createdAt    DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @db.Timestamptz(3)
  memberships  ClinicMembership[]
  authVersion   Int                @default(0)
  sessions      Session[]
  mfa           UserMfa?
  mfaChallenges MfaChallenge[]
}

// Tenant resource and identity bridge: scoped SELECT, maintenance-only writes.
model ClinicMembership {
  id        String           @id @default(uuid()) @db.Uuid
  clinicId  String           @db.Uuid
  userId    String           @db.Uuid
  role      ClinicRole
  status    MembershipStatus @default(INVITED)
  version   Int              @default(1)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  clinic    Clinic           @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  bookableResource BookableResource?
  financialAuditEvents FinancialAuditEvent[]
  clinicalEncounters ClinicalEncounter[] @relation("EncounterClinician")
  authoredClinicalNotes ClinicalNote[] @relation("ClinicalNoteAuthor")
  clinicalNoteAmendments ClinicalNoteAmendment[] @relation("ClinicalAmendmentAuthor")
  reviewedMedicalHistories MedicalHistory[] @relation("MedicalHistoryReviewer")
  authoredTreatmentPlans TreatmentPlan[] @relation("TreatmentPlanClinician")
  authoredTreatmentRevisions TreatmentPlanRevision[] @relation("TreatmentRevisionAuthor")
  approvedTreatmentRevisions TreatmentPlanRevision[] @relation("TreatmentRevisionApprover")
  procedureExecutions ProcedureExecution[] @relation("ProcedureClinician")
  publishedConsentTemplateVersions ConsentTemplateVersion[] @relation("ConsentTemplateVersionPublisher")
  preparedPatientConsents PatientConsent[] @relation("ConsentPreparer")
  verifiedPatientConsents PatientConsent[] @relation("ConsentVerifier")
  withdrawnPatientConsents ConsentWithdrawal[] @relation("ConsentWithdrawer")
  clinicalPhotoSessions ClinicalPhotoSession[] @relation("PhotoSessionClinician")
  clinicalPhotos ClinicalPhoto[] @relation("PhotoClinician")
  photoComparisonGroups PhotoComparisonGroup[] @relation("PhotoComparisonClinician")
  photoAnnotations PhotoAnnotation[] @relation("PhotoAnnotationAuthor")
  treatingFollowUps ClinicalFollowUp[] @relation("FollowUpTreatingDoctor")
  authoredAssessments FollowUpAssessment[] @relation("FollowUpAssessmentDoctor")
  authoredAssessmentAmendments FollowUpAssessmentAmendment[] @relation("AssessmentAmendmentAuthor")
  recordedOutcomes TreatmentOutcome[] @relation("OutcomeRecorder")
  reportedAdverseEvents AdverseEvent[] @relation("AdverseEventReporter")
  inventoryMovements InventoryStockMovement[] @relation("InventoryActor")
  inventoryConsumptions InventoryClinicalConsumption[] @relation("ConsumptionActor")
  purchaseOrdersCreated InventoryPurchaseOrder[] @relation("POCreator")
  purchaseOrdersApproved InventoryPurchaseOrder[] @relation("POApprover")
  goodsReceiptsReceived InventoryGoodsReceipt[] @relation("GRReceiver")
  stockCountsCounted InventoryStockCount[] @relation("SCCounter")
  stockCountsApproved InventoryStockCount[] @relation("SCApprover")
  alertAcknowledgments InventoryAlertAcknowledgment[]
  packageVersionsPublished TreatmentPackageVersion[] @relation("PackageVersionPublisher")
  packageRedemptions PackageRedemption[] @relation("PackageRedeemer")
  packageRedemptionReversals PackageRedemptionReversal[] @relation("PackageRedemptionReverser")
  installmentAllocations InstallmentAllocation[] @relation("InstallmentAllocator")
  refundRequestsMade RefundRequest[] @relation("RefundRequester")
  refundRequestsApproved RefundRequest[] @relation("RefundApprover")
  refundRequestsRejected RefundRequest[] @relation("RefundRejecter")
  refundRequestsSettled RefundRequest[] @relation("RefundSettler")
  commissionAssignments PractitionerCommissionAssignment[] @relation("PractitionerCommissionAssignee")
  commissionSettlements PractitionerCommissionSettlement[] @relation("CommissionSettlementPractitioner")
  confirmedCommissionSettlements PractitionerCommissionSettlement[] @relation("CommissionSettlementConfirmer")
  commissionAccruals PractitionerCommissionAccrual[] @relation("CommissionAccrualPractitioner")
  approvedCommissionAccruals PractitionerCommissionAccrual[] @relation("CommissionAccrualApprover")
  requestedCommissionAdjustments PractitionerCommissionAdjustment[] @relation("CommissionAdjustmentRequester")
  decidedCommissionAdjustments PractitionerCommissionAdjustment[] @relation("CommissionAdjustmentDecider")
  reviewedCheckIns PatientRecoveryCheckIn[] @relation("CheckInReviewer")
  branchMemberships BranchMembership[]
  dispatchedTransfers InterBranchTransfer[] @relation("TransferDispatcher")
  receivedTransfers InterBranchTransfer[] @relation("TransferReceiver")
  cancelledTransfers InterBranchTransfer[] @relation("TransferCanceller")
  approvedLandedCosts InventoryLandedCost[] @relation("LandedCostApprover")
  approvedValuationSnapshots InventoryValuationSnapshot[] @relation("ValuationApprover")
  approvedCostAdjustments InventoryCostAdjustment[] @relation("CostAdjustmentApprover")
  initiatedPaymentIntents PaymentIntent[] @relation("PaymentIntentInitiator")
  initiatedExternalRefunds ExternalRefund[] @relation("ExternalRefundInitiator")
  preparedExternalPayouts ExternalPayout[] @relation("ExternalPayoutPreparer")
  approvedExternalPayouts ExternalPayout[] @relation("ExternalPayoutApprover")
  executedReconciliationRuns ExternalReconciliationRun[] @relation("ReconciliationRunner")
  createdRegulatoryDocuments RegulatoryDocument[] @relation("RegulatoryDocCreator")
  submittedRegulatorySubmissions RegulatorySubmission[] @relation("RegulatorySubmitter")
  practitionerProfile PractitionerProfile? @relation("PractitionerMembership")
  verifiedPractitionerProfiles PractitionerProfile[] @relation("PractitionerProfileVerifier")
  verifiedPractitionerSpecialties PractitionerSpecialty[] @relation("PractitionerSpecialtyVerifier")
  approvedClinicalPrivileges PractitionerClinicalPrivilege[] @relation("ClinicalPrivilegeApprover")
  authoredObservations ClinicalObservation[] @relation("ObservationAuthor")
  authoredDiagnoses EncounterDiagnosis[] @relation("DiagnosisAuthor")
  confirmedDiagnoses EncounterDiagnosis[] @relation("DiagnosisConfirmer")
  recordedAllergies PatientAllergy[] @relation("AllergyRecorder")
  verifiedAllergies PatientAllergy[] @relation("AllergyVerifier")
  recordedMedications MedicationRecord[] @relation("MedicationRecorder")
  verifiedMedications MedicationRecord[] @relation("MedicationVerifier")
  reconciledMedications MedicationRecord[] @relation("MedicationReconciler")
  prescriptions MedicationPrescription[] @relation("PrescriptionPrescriber")
  signedPrescriptions MedicationPrescription[] @relation("PrescriptionSigner")
  orderedClinicalOrders ClinicalOrder[] @relation("OrderingDoctor")
  recordedClinicalResults ClinicalOrderResult[] @relation("ResultRecorder")
  verifiedClinicalResults ClinicalOrderResult[] @relation("ResultVerifier")
  uploadedClinicalDocuments ClinicalDocument[] @relation("DocumentUploader")
  authoredClinicalFormDefinitions ClinicalFormDefinition[] @relation("ClinicalFormDefinitionAuthor")
  authoredClinicalFormVersions ClinicalFormDefinitionVersion[] @relation("ClinicalFormVersionAuthor")
  publishedClinicalFormVersions ClinicalFormDefinitionVersion[] @relation("ClinicalFormVersionPublisher")
  authoredClinicalFormResponses ClinicalFormResponse[] @relation("ClinicalFormResponseAuthor")
  finalizedClinicalFormResponses ClinicalFormResponse[] @relation("ClinicalFormResponseFinalizer")
  authoredClinicalFormAmendments ClinicalFormResponseAmendment[] @relation("ClinicalFormAmendmentAuthor")
  authoredSafetyPolicies ClinicalSafetyPolicyVersion[] @relation("SafetyPolicyAuthor")
  approvedSafetyPolicies ClinicalSafetyPolicyVersion[] @relation("SafetyPolicyApprover")
  reportedClinicalIncidents ClinicalIncident[] @relation("IncidentReporter")
  investigatedClinicalIncidents ClinicalIncident[] @relation("IncidentInvestigator")
  requestedBreakGlassAccesses EmergencyBreakGlassAccess[] @relation("BreakGlassRequester")
  revokedBreakGlassAccesses EmergencyBreakGlassAccess[] @relation("BreakGlassRevoker")
  auditedBreakGlassAccesses EmergencyBreakGlassAccess[] @relation("BreakGlassAuditor")
  conductedPrivilegeReviews PractitionerPrivilegeReview[] @relation("PrivilegeReviewer")
  authoredOdontograms DentalOdontogram[] @relation("OdontogramAuthor")
  finalizedOdontograms DentalOdontogram[] @relation("OdontogramFinalizer")
  recordedToothFindings DentalToothFinding[] @relation("ToothFindingRecorder")
  periodontalExaminations DentalPeriodontalRecord[] @relation("PeriodontalExaminer")
  plannedDentalStages DentalTreatmentStage[] @relation("DentalStagePlanner")
  approvedDentalStages DentalTreatmentStage[] @relation("DentalStageApprover")
  completedDentalStages DentalTreatmentStage[] @relation("DentalStageCompleter")
  verifiedBirthHistories PediatricBirthHistory[] @relation("PediatricBirthHistoryVerifier")
  revokedCaregivers PatientCaregiverRelationship[] @relation("CaregiverRevokedBy")
  recordedGrowthRecords PediatricGrowthRecord[] @relation("PediatricGrowthRecordedBy")
  pregnancyEpisodesReviewed PregnancyEpisode[] @relation("PregnancyDatingReviewer")
  pregnancyEpisodesFinalized PregnancyEpisode[] @relation("PregnancyEpisodeFinalizer")
  antenatalVisitsRecorded AntenatalVisitRecord[] @relation("AntenatalVisitRecorder")
  obstetricHistoriesRecorded ObstetricHistoryRecord[] @relation("ObstetricHistoryRecorder")
  gynecologicalExamsPerformed GynecologicalExamination[] @relation("GynecologicalExamExaminer")
  ophthalmicRefractionsMeasured OphthalmicRefractionRecord[] @relation("OphthalmicRefractionOptometrist")
  ophthalmicExamsPerformed OphthalmicExaminationRecord[] @relation("OphthalmicExaminationExaminer")
  entExamsPerformed EntExaminationRecord[] @relation("EntExaminationExaminer")
  audiometryAssessmentsPerformed AudiometryAssessmentRecord[] @relation("AudiometryAssessmentAudiologist")
  conductedMskExaminations MusculoskeletalExamination[] @relation("MusculoskeletalExaminationExaminer")
  conductedRomExaminations JointRangeOfMotionRecord[] @relation("JointRangeOfMotionExaminer")
  referredPtEpisodes PhysiotherapyRehabilitationEpisode[] @relation("PhysiotherapyEpisodeReferringClinician")
  managedPtEpisodes PhysiotherapyRehabilitationEpisode[] @relation("PhysiotherapyEpisodeTherapist")
  conductedPtSessions PhysiotherapySessionRecord[] @relation("PhysiotherapySessionTherapist")

  // One current role per user/clinic; the same user can join many clinics.
  @@unique([clinicId, userId])
  @@unique([clinicId, id])
  @@index([userId, status])
  @@index([clinicId, status, role])
}

// Global identity infrastructure, never an authorization grant for a clinic.
model Session {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique @db.Char(64)
  csrfHash          String    @db.Char(64)
  authorizationHash String    @db.Char(64)
  selectedClinicId  String?   @db.Uuid
  selectedBranchId  String?   @db.Uuid
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
