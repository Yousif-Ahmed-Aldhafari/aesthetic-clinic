model ClinicalPhoto {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @db.Uuid
  patientId             String                @db.Uuid
  photoSessionId        String                @db.Uuid
  clinicianMembershipId String                @db.Uuid
  category              PhotoCategory
  bodyArea              String                @db.VarChar(100)
  caption               String?               @db.VarChar(500)
  storageKey            String                @db.VarChar(255)
  thumbnailStorageKey   String                @db.VarChar(255)
  originalFileName      String                @db.VarChar(255)
  mimeType              String                @db.VarChar(50)
  byteSize              Int
  sha256Digest          String                @db.VarChar(64)
  width                 Int
  height                Int
  takenAt               DateTime              @db.Timestamptz(3)
