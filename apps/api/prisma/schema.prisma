model PaymentIntent {
  id                          String                       @id @default(uuid()) @db.Uuid
  clinicId                    String                       @db.Uuid
  branchId                    String?                      @db.Uuid
  invoiceId                   String                       @db.Uuid
  patientId                   String                       @db.Uuid
  providerConfigId            String                       @db.Uuid
  providerCode                PaymentProviderCode
  mode                        IntegrationMode              @default(SANDBOX)
  providerIntentId            String?                      @db.VarChar(128)
  amountMinor                 BigInt
  currency                    String                       @db.Char(3)
  currencyScale               Int
  status                      PaymentIntentStatus          @default(CREATED)
  checkoutUrl                 String?                      @db.VarChar(500)
  initiatedByMembershipId     String?                      @db.Uuid
  initiatedByPatientAccountId String?                      @db.Uuid
  postedPaymentId             String?                      @db.Uuid
  failureCode                 String?                      @db.VarChar(80)
  failureMessage              String?                      @db.VarChar(300)
  idempotencyKey              String                       @db.Uuid
  requestHash                 String                       @db.Char(64)
  version                     Int                          @default(1)
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  expiresAt                   DateTime?                    @db.Timestamptz(3)
  webhookTicketHash           String?                      @db.VarChar(64)
  webhookTicketExpiresAt      DateTime?                    @db.Timestamptz(3)

  clinic                      Clinic                       @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  branch                      ClinicBranch?                @relation(fields: [clinicId, branchId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  invoice                     Invoice                      @relation(fields: [clinicId, invoiceId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  patient                     Patient                      @relation(fields: [clinicId, patientId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  providerConfig              PaymentProviderConfiguration @relation(fields: [clinicId, providerConfigId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  initiatedByMembership       ClinicMembership?            @relation("PaymentIntentInitiator", fields: [clinicId, initiatedByMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  initiatedByPatientAccount   PatientAccount?              @relation(fields: [clinicId, initiatedByPatientAccountId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  postedPayment               Payment?                     @relation(fields: [clinicId, postedPaymentId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  events                      PaymentProviderEvent[]
  externalRefunds             ExternalRefund[]

  @@unique([clinicId, id])
  @@unique([clinicId, idempotencyKey])
  @@unique([clinicId, providerCode, providerIntentId])
  @@index([clinicId, invoiceId, status])
  @@index([clinicId, status, createdAt])
}

model PaymentProviderEvent {
