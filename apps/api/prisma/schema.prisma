  PRESCRIPTION_SAFETY
  CRITICAL_RESULT_ESCALATION
  FORM_APPROVAL
  CLINICAL_PROTOCOL
  GENERAL_SAFETY
}

enum ClinicalIncidentSeverity {
  NEAR_MISS
  LOW
  MODERATE
  SEVERE
  SENTINEL
}

enum ClinicalIncidentCategory {
