  priceMinor              BigInt
  currency                String                 @db.Char(3)
  currencyScale           Int
  validityDays            Int                    @default(365)
  isPublished             Boolean                @default(false)
  publishedAt             DateTime?              @db.Timestamptz(3)
  publishedByMembershipId String?                @db.Uuid
