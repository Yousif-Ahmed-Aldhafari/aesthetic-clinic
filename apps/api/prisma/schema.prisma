  supplierName     String?                 @db.VarChar(200)
  supplierId       String?                 @db.Uuid
  quarantinedAt    DateTime?               @db.Timestamptz(3)
  quarantineReason String?                 @db.VarChar(500)
  recalledAt       DateTime?               @db.Timestamptz(3)
  recallReason     String?                 @db.VarChar(500)
  version          Int                     @default(1)
  createdAt        DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                @updatedAt @db.Timestamptz(3)

  clinic           Clinic                  @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product          InventoryProduct        @relation(fields: [clinicId, productId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  supplier         InventorySupplier?      @relation(fields: [clinicId, supplierId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  batchBalances    InventoryBatchBalance[]
