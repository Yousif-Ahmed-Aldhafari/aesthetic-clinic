model InventoryStockMovement {
  id                String                @id @default(uuid()) @db.Uuid
  clinicId          String                @db.Uuid
  productId         String                @db.Uuid
  locationId        String                @db.Uuid
  batchId           String?               @db.Uuid
  sourceLocationId  String?               @db.Uuid
  movementType      InventoryMovementType
  quantity          Decimal               @db.Decimal(12, 4)
  balanceAfter      Decimal               @db.Decimal(12, 4)
  reasonCode        InventoryReasonCode
  reasonExplanation String?               @db.VarChar(1000)
  actorMembershipId String                @db.Uuid
  idempotencyKey    String?               @db.VarChar(100)
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)

  clinic            Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product           InventoryProduct      @relation(fields: [clinicId, productId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  location          InventoryLocation     @relation("LocationMovements", fields: [clinicId, locationId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceLocation    InventoryLocation?    @relation("SourceLocationMovements", fields: [clinicId, sourceLocationId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  batch             InventoryBatch?       @relation(fields: [clinicId, batchId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  actor             ClinicMembership      @relation("InventoryActor", fields: [clinicId, actorMembershipId], references: [clinicId, id], onDelete: Restrict, onUpdate: Restrict)
  balancesAsLast    InventoryBalance[]    @relation("LastMovement")
  consumptionsAsSource InventoryClinicalConsumption[] @relation("ConsumptionSourceMovement")
  consumptionsAsVoid   InventoryClinicalConsumption[] @relation("ConsumptionVoidMovement")
  goodsReceiptLines    InventoryGoodsReceiptLine[]
  stockCountItems      InventoryStockCountItem[]

  @@unique([clinicId, id])
  @@unique([clinicId, idempotencyKey])
  @@index([clinicId, productId, locationId, createdAt])
  @@index([clinicId, batchId, createdAt])
  @@index([clinicId, movementType, createdAt])
  @@index([clinicId, actorMembershipId, createdAt])
}

model InventoryBalance {
