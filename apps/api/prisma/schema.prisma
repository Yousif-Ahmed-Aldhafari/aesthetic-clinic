  activeForPolicies      ClinicalSafetyPolicy[] @relation("ActivePolicyVersion")

  @@unique([clinicId, id])
  @@unique([policyId, versionNumber])
  @@index([clinicId, policyId, status])
}

// Clinical incident reporting and root-cause analysis
model ClinicalIncident {
  id                         String                   @id @default(uuid()) @db.Uuid
