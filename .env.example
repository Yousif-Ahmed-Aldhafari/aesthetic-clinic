# Development only. Native setup generates private values in the ignored .env.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_CSRF_SECRET=
AUTH_SESSION_HOURS=8
AUTH_IDLE_MINUTES=30
AUTH_LOGIN_ACCOUNT_LIMIT=5
AUTH_LOGIN_IP_LIMIT=30
# Only set to 1 behind a trusted, network-restricted HTTPS reverse proxy.
TRUST_PROXY_HOPS=0

# Reservations only; DNS routing/TLS activation is a deployment task.
PLATFORM_BASE_DOMAIN=lamssa.localhost
# Optional exact hostnames. Defaults to API_HOST + configured CORS hostnames
# (and localhost in development). No wildcards or forwarded-host tenant routing.
# API_ALLOWED_HOSTS=localhost,127.0.0.1
# Development defaults to ignored var/clinic-assets. Production must explicitly
# mount a private persistent directory; a future object-storage adapter is separate.
# ASSET_STORAGE_DIR=/absolute/private/lamssa-assets

POSTGRES_DB=lamssa_dev
POSTGRES_USER=lamssa_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Use the same credentials as above; percent-encode special characters in the URL.
DATABASE_URL=postgresql://lamssa_dev:REPLACE_ME@127.0.0.1:5432/lamssa_dev?schema=public

# Native PostgreSQL: separate migration owners and runtime logins for each database.
# Migration roles have no cluster administration privileges; runtime roles have DML only.
# MIGRATION_DATABASE_URL=postgresql://lamssa_dev_migrator:REPLACE_ME@127.0.0.1:5432/lamssa_dev?schema=public
# TEST_DATABASE_URL=postgresql://lamssa_test_app:REPLACE_ME@127.0.0.1:5432/lamssa_test?schema=public
# TEST_MIGRATION_DATABASE_URL=postgresql://lamssa_test_migrator:REPLACE_ME@127.0.0.1:5432/lamssa_test?schema=public

# Compose credentials above are separate from the native roles. Do not start both
# services on the same host port. No shadow database is needed for migrate deploy.
