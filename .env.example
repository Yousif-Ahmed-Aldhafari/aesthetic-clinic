# Development only. Copy to .env and replace the password before starting PostgreSQL.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=lamssa_dev
POSTGRES_USER=lamssa_dev
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Use the same credentials as above; percent-encode special characters in the URL.
DATABASE_URL=postgresql://lamssa_dev:REPLACE_ME@127.0.0.1:5432/lamssa_dev?schema=public

# Optional: dedicated, migrated disposable database for live constraint tests.
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/lamssa_test?schema=public
