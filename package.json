{
  "name": "lamssa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "test:deployment-runtime": "node scripts/verify-deployment-runtime.mjs",
    "dev": "npm run dev --workspace @lamssa/web --",
    "dev:web": "npm run dev --workspace @lamssa/web --",
    "dev:api": "npm run dev --workspace @lamssa/api --",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace @lamssa/web --",
    "build:api": "npm run build --workspace @lamssa/api --",
    "preview": "npm run preview --workspace @lamssa/web --",
    "start:api": "npm run start --workspace @lamssa/api --",
    "test": "npm run test --workspaces",
    "test:db": "npm run test:db --workspace @lamssa/api --",
    "db:generate": "npm run db:generate --workspace @lamssa/api --",
    "db:validate": "npm run db:validate --workspace @lamssa/api --",
    "db:migrate": "npm run db:migrate --workspace @lamssa/api --",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @lamssa/api --",
    "db:status": "npm run db:status --workspace @lamssa/api --",
    "db:seed": "npm run db:seed --workspace @lamssa/api --",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:env:native": "node scripts/native-postgres-env.mjs",
    "db:migrate:test": "node scripts/test-database-command.mjs migrate",
    "db:status:test": "node scripts/test-database-command.mjs status",
    "db:grant": "node scripts/grant-database-access.mjs",
    "auth:provision": "npm run auth:provision --workspace @lamssa/api --",
    "db:backup": "node scripts/backup-database.mjs",
    "db:restore": "node scripts/restore-database.mjs",
    "db:backup:drill": "node scripts/restore-database.mjs --drill",
    "assets:backup": "node scripts/asset-backup.mjs",
    "assets:restore": "node scripts/restore-assets.mjs",
    "check:boundaries": "node scripts/check-database-boundaries.mjs",
    "test:web": "npm run test --workspace @lamssa/web --",
    "test:browser": "npm run build && npm run test:compile --workspace @lamssa/api && node scripts/patients-browser-smoke.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "test:production-smoke": "node scripts/production-smoke.mjs"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "argon2@0.45.1": true
  }
}
